<section class="page-header">
  <div class="page-header-info">
    <h2>المساعد الذكي</h2>
    <p>اسأل عن أي مفهوم قانوني — المساعد يجيب وفق تخصصات الأكاديمية.</p>
  </div>
</section>

<% if (!assistantReady) { %>
  <div class="alert-inline warning" role="note">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
    <div>المساعد غير مُفعّل بعد — يمكن للمالك تفعيله من الإعدادات بإدخال مفتاح Gemini (Google AI).</div>
  </div>
<% } %>

<!-- سجل المحادثة -->
<div class="chat-thread" id="chatThread" style="display:flex;flex-direction:column;gap:12px;margin-bottom:16px;max-height:520px;overflow-y:auto;padding:4px;">
  <% if (!history.length) { %>
    <div class="empty-state" style="border-style:dashed;">
      <h3>ابدأ المحادثة</h3>
      <p>مثال: «ما هي مصادر القانون الرسمية والاحتياطية في القانون العراقي؟»</p>
    </div>
  <% } %>
  <% for (const message of history) { %>
    <div class="chat-message <%= message.role %>" style="max-width:78%;padding:12px 16px;border-radius:14px;line-height:1.9;<%= message.role === 'user' ? 'align-self:flex-end;background:var(--navy-dark);color:var(--text-inverse);border-end-end-radius:4px;' : 'align-self:flex-start;background:var(--bg-surface);border:1px solid var(--border);border-end-start-radius:4px;' %>">
      <%= message.content %>
    </div>
  <% } %>
</div>

<form method="post" action="/ai-assistant" class="table-card">
  <div class="side-card-body" style="padding:14px 16px;display:flex;gap:10px;align-items:flex-end;">
    <textarea name="message" rows="2" required maxlength="2000" placeholder="اكتب سؤالك القانوني هنا..." style="flex:1;border:1px solid var(--border-strong);border-radius:12px;padding:12px 14px;font:inherit;resize:vertical;min-height:56px;"></textarea>
    <button type="submit" class="btn btn-primary" style="flex:none;">إرسال</button>
  </div>
</form>

<p class="muted" style="font-size:0.75rem;margin-top:10px;">المساعد يدرّب على المفاهيم القانونية العامة ولا يُغني عن الاستشارة القانونية المتخصصة.</p>

<script>
(function () {
  const thread = document.getElementById("chatThread");
  if (thread) thread.scrollTop = thread.scrollHeight;
})();
</script>
