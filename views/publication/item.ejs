<section class="page-header">
  <div class="page-header-info">
    <h2><%= paper ? 'تفاصيل البحث' : 'غير موجود' %></h2>
    <% if (paper) { %><p><%= paper.authorName %><%= paper.authorPosition ? ' · ' + paper.authorPosition : '' %></p><% } %>
  </div>
  <% if (paper && canSeeFile) { %>
    <div class="page-header-actions"><a class="btn btn-secondary" href="/publication/file/<%= paper.id %>">تحميل ملف البحث</a></div>
  <% } %>
</section>

<% if (!paper) { %>
  <div class="empty-state"><h3>البحث غير موجود</h3><p>البحث غير موجود أو حُذف من الكتالوج.</p></div>
<% } else { %>

  <div class="table-card" style="margin-bottom:20px;">
    <div class="table-card-head"><h3>عنوان البحث</h3></div>
    <div class="side-card-body" style="padding:18px 22px;">
      <h3 style="font-family:var(--font-head);font-size:1.35rem;line-height:1.6;margin:0;"><%= paper.title %></h3>
      <% if (paper.keywords) { %><p class="muted" style="margin-top:10px;"><%= paper.keywords %></p><% } %>
      <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;">
        <% if (typeof statusLabel !== 'undefined') { %><span class="chip"><%= statusLabel %></span><% } %>
        <% if (paper.published_at) { %><span class="chip"><%= format.formatDate(paper.published_at) %></span><% } %>
      </div>
    </div>
  </div>

  <div class="table-card" style="margin-bottom:20px;">
    <div class="table-card-head"><h3>الملخص العربي</h3></div>
    <div class="side-card-body" style="padding:18px 22px;line-height:2;color:var(--text-secondary);"><%= paper.abstract_ar || '—' %></div>
  </div>

  <% if (paper.abstract_en) { %>
    <div class="table-card" style="margin-bottom:20px;">
      <div class="table-card-head"><h3>English abstract</h3></div>
      <div class="side-card-body" style="padding:18px 22px;line-height:2;color:var(--text-secondary);direction:ltr;text-align:left;"><%= paper.abstract_en %></div>
    </div>
  <% } %>

  <% if (typeof acceptedNote !== 'undefined' && acceptedNote) { %>
    <div class="alert-inline info" role="note">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
      <div><strong>ملاحظة المحرر:</strong> <%= acceptedNote %></div>
    </div>
  <% } %>

  <div style="margin-top:18px;display:flex;gap:10px;flex-wrap:wrap;">
    <a class="btn btn-secondary" href="/publication">العودة إلى قسم النشر</a>
    <% if (canSeeFile) { %><a class="btn btn-secondary" href="/publication/file/<%= paper.id %>">تحميل ملف البحث</a><% } %>
  </div>
<% } %>
