<section class="page-header">
  <div class="page-header-info">
    <h2>تقديم بحث للنشر</h2>
    <p>يُعرض بحثك على محكّمَين من ذوي الاختصاص؛ يحصل عند النشر شهادة نشر للأكاديمية.</p>
  </div>
</section>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert-inline error" role="alert">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
    <div><%= error %></div>
  </div>
<% } %>

<form method="post" action="/publication/submit" class="table-card" enctype="multipart/form-data">
  <div class="side-card-body" style="padding:24px;">
    <div class="form-grid">
      <label>عنوان البحث *
        <input type="text" name="title" required maxlength="300" placeholder="مثال: شروط تطبيق نظرية الظروف الطارئة في العقود القانونية">
      </label>
      <label>الكلمات المفتاحية
        <input type="text" name="keywords" maxlength="200" placeholder="مثال: نظرية، الظروف الطارئة، المسؤولية العقدية">
      </label>
      <label>الملخص بالعربية * (لا يقل عن 50 كلمة)
        <textarea name="abstract_ar" rows="4" required minlength="50" placeholder="اكتب ملخصاً للبحث بالعربية..."></textarea>
      </label>
      <label>الملخص بالإنجليزية (اختياري لكن مطلوب في النسخة المنشورة)
        <textarea name="abstract_en" rows="4" placeholder="English abstract..." dir="ltr" style="text-align:left;"></textarea>
      </label>

      <div class="fieldset-block">
        <div class="fieldset-title">ملف البحث (PDF أو Word — حتى 25MB)</div>
        <label class="file-upload" for="manuscript">
          <input type="file" id="manuscript" name="manuscript" accept=".pdf,.doc,.docx" required hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:30px;height:30px;color:var(--gold-dark);"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
          <div class="file-upload-text">انقر لاختيار ملف</div>
          <div class="file-upload-sub">PDF / DOC / DOCX — حتى 25 ميجابايت</div>
        </label>
        <p id="fileName" class="form-hint" style="margin-top:8px;"></p>
      </div>

      <div class="alert-inline info" role="note" style="margin-top:4px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
        <div>يجب أن يكون البحث <strong>أصيلاً ولم ينشر سابقاً ولم يُعرض على مجلة أخرى</strong>. سيعرض على محكّمَين مستقلين من ذوي الاختصاص، ويعتمد قرار النشر على توصية المحكّمين وقرار هيئة التحرير.</div>
      </div>
    </div>

    <div style="display:flex;gap:10px;margin-top:18px;">
      <button type="submit" class="btn btn-primary">إرسال البحث للتحكيم</button>
      <a class="btn btn-secondary" href="/publication">إلغاء</a>
    </div>
  </div>
</form>

<script>
(function () {
  const input = document.getElementById("manuscript");
  const name = document.getElementById("fileName");
  input?.addEventListener("change", () => {
    if (name) name.textContent = input.files?.[0]?.name ? "الملف المختار: " + input.files[0].name : "";
  });
})();
</script>
