<!-- ============ خلفية ============ -->
  <div class="bg-layer" aria-hidden="true">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div class="pattern"></div>
    <div class="vignette"></div>
  </div>

  <!-- ============ الشريط العلوي ============ -->
  <header class="site-header" id="header">
    <div class="container nav-inner">
      <a href="#" class="brand" aria-label="أكاديمية آل الزين — الصفحة الرئيسية">
        <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M32 6v46" />
          <path d="M20 52h24" />
          <circle cx="32" cy="10" r="3" fill="currentColor" stroke="none" />
          <path d="M10 18h44" />
          <path d="M10 18L4 32h12L10 18z" />
          <path d="M54 18L48 32h12L54 18z" />
          <path d="M4 32a6 6 0 0 0 12 0" />
          <path d="M48 32a6 6 0 0 0 12 0" />
        </svg>
        <span class="brand-text">
          أكاديمية آل الزين
          <small>للعلوم القانونية والعدلية</small>
        </span>
      </a>

      <nav class="nav-links" aria-label="التنقل الرئيسي">
        <a href="#about">عن الأكاديمية</a>
        <a href="#features">المزايا</a>
        <a href="#tracks">المسارات</a>
        <a href="#library">المكتبة</a>
        <a href="#portals">البوابات</a>
      </nav>

      <a href="#portals" class="nav-cta">
        دخول المنصة
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>

      <button class="menu-toggle" aria-label="القائمة" id="menuToggle">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </button>
    </div>
  </header>

  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-text reveal">
          <div class="hero-tag">منصة تعليمية قانونية معتمدة</div>
          <h1>
            نُعِدُّ جيلاً من <span class="accent">رجال القانون</span><br>
            والعدالة بمعايير أكاديمية رفيعة
          </h1>
          <p class="hero-lead">
            أكاديمية آل الزين للعلوم القانونية والعدلية منصة تعليمية عربية متكاملة تجمع بين
            المحاضرات المباشرة، الاختبارات الإلكترونية، المكتبة القانونية المتخصصة،
            والبحث العلمي — في تجربة تعليمية واحدة متكاملة.
          </p>

          <div class="hero-actions">
            <a href="#portals" class="btn btn-primary">
              ابدأ رحلتك الآن
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
            <a href="#about" class="btn btn-ghost">
              تعرّف على الأكاديمية
            </a>
          </div>

          <div class="hero-features">
            <div class="feat">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6L9 17l-5-5" />
              </svg>
              محاضرات مباشرة ومسجلة
            </div>
            <div class="feat">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6L9 17l-5-5" />
              </svg>
              اختبارات إلكترونية فورية
            </div>
            <div class="feat">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6L9 17l-5-5" />
              </svg>
              مكتبة قانونية رقمية
            </div>
          </div>
        </div>

        <div class="hero-visual reveal">
          <div class="emblem-large" aria-hidden="true">
            <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M32 6v46" />
              <path d="M20 52h24" />
              <circle cx="32" cy="10" r="3.2" fill="currentColor" stroke="none" />
              <path d="M10 18h44" />
              <path d="M10 18L4 32h12L10 18z" />
              <path d="M54 18L48 32h12L54 18z" />
              <path d="M4 32a6 6 0 0 0 12 0" />
              <path d="M48 32a6 6 0 0 0 12 0" />
            </svg>
          </div>
          <div class="float-badge b1">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3L2 9l10 6 10-6-10-6z" />
              <path d="M6 11v5c0 1.5 3 3 6 3s6-1.5 6-3v-5" />
            </svg>
            محاضرات مباشرة
          </div>
          <div class="float-badge b2">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
              <path d="M22 4L12 14l-3-3" />
            </svg>
            تصحيح تلقائي
          </div>
          <div class="float-badge b3">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
            </svg>
            مكتبة رقمية
          </div>
        </div>
      </div>

      <!-- شريط الإحصاءات — بيانات حقيقية من قاعدة البيانات -->
      <div class="stats-bar reveal" role="list" aria-label="إحصاءات الأكاديمية">
        <div class="stat" role="listitem">
          <div class="stat-value"><%= format.formatNumber(stats.students) %></div>
          <div class="stat-label">طالب مسجّل</div>
        </div>
        <div class="stat" role="listitem">
          <div class="stat-value"><%= format.formatNumber(stats.courses) %></div>
          <div class="stat-label">مقرر دراسي</div>
        </div>
        <div class="stat" role="listitem">
          <div class="stat-value"><%= format.formatNumber(stats.lectures) %></div>
          <div class="stat-label">محاضرة</div>
        </div>
        <div class="stat" role="listitem">
          <div class="stat-value"><%= format.formatNumber(stats.libraryItems) %></div>
          <div class="stat-label">عنصر في المكتبة</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ نبذة عن الأكاديمية ============ -->
  <section class="section" id="about">
    <div class="container">
      <div class="about-grid">
        <div class="about-visual reveal">
          <div class="about-visual-inner">
            <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M32 6v46" />
              <path d="M20 52h24" />
              <circle cx="32" cy="10" r="3" fill="currentColor" stroke="none" />
              <path d="M10 18h44" />
              <path d="M10 18L4 32h12L10 18z" />
              <path d="M54 18L48 32h12L54 18z" />
              <path d="M4 32a6 6 0 0 0 12 0" />
              <path d="M48 32a6 6 0 0 0 12 0" />
            </svg>
            <h3>رسالتنا</h3>
            <p>إعداد كوادر قانونية مؤهلة علمياً وعملياً</p>
          </div>
        </div>

        <div class="about-text reveal">
          <div class="section-head">
            <div class="section-eyebrow">عن الأكاديمية</div>
            <h2 class="section-title">
              منصة قانونية <span class="accent">بمعايير أكاديمية</span> رفيعة
            </h2>
          </div>
          <p>
            تأسست أكاديمية آل الزين للعلوم القانونية والعدلية لتكون منارةً علميةً
            في مجال الدراسات القانونية والعدلية في العالم العربي، تجمع بين
            الأصالة الأكاديمية والتقنية الحديثة، وتقدّم تجربة تعليمية متكاملة
            تواكب متطلبات العصر الرقمي.
          </p>
          <p>
            نلتزم بتقديم محتوى علمي رصين بإشراف نخبة من الأساتذة المتخصصين،
            في بيئة تعليمية تفاعلية تُنمّي مهارات الطالب البحثية والعملية،
            وتُهيّئه لسوق العمل القانوني بثقةٍ واقتدار.
          </p>

          <div class="about-points">
            <div class="about-point">
              <div class="about-point-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                </svg>
              </div>
              <div>
                <strong>تميز أكاديمي</strong>
                <span>مناهج معتمدة بإشراف متخصصين</span>
              </div>
            </div>
            <div class="about-point">
              <div class="about-point-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M12 6v6l4 2" />
                </svg>
              </div>
              <div>
                <strong>مرونة تعليمية</strong>
                <span>محاضرات مباشرة ومسجلة على مدار الساعة</span>
              </div>
            </div>
            <div class="about-point">
              <div class="about-point-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
              </div>
              <div>
                <strong>إشراف مباشر</strong>
                <span>متابعة فردية لكل طالب</span>
              </div>
            </div>
            <div class="about-point">
              <div class="about-point-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" />
                </svg>
              </div>
              <div>
                <strong>مكتبة متخصصة</strong>
                <span>آلاف المراجع القانونية الرقمية</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ المزايا ============ -->
  <section class="section" id="features">
    <div class="container">
      <div class="section-head reveal">
        <div class="section-eyebrow">لماذا آل الزين</div>
        <h2 class="section-title">
          مزايا <span class="accent">تُحدث الفرق</span> في تجربتك التعليمية
        </h2>
        <p class="section-sub">
          منظومة تعليمية متكاملة صُمّمت لتوفّر للطالب و member هيئة التدريس أفضل بيئة تعليمية قانونية
        </p>
      </div>

      <div class="features-grid">
        <div class="feature-card reveal">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M23 7l-7 5 7 5V7z" />
              <rect x="1" y="5" width="15" height="14" rx="2" />
            </svg>
          </div>
          <h3>محاضرات تفاعلية</h3>
          <p>محاضرات مباشرة ومسجلة عالية الجودة، مع أدوات تفاعل مباشرة بين الأستاذ والطلاب.</p>
        </div>

        <div class="feature-card reveal">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
              <path d="M22 4L12 14l-3-3" />
            </svg>
          </div>
          <h3>اختبارات ذكية</h3>
          <p>نظام اختبارات إلكتروني متكامل بتصحيح تلقائي وتحليل فوري للنتائج والأداء.</p>
        </div>

        <div class="feature-card reveal">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
            </svg>
          </div>
          <h3>مكتبة قانونية</h3>
          <p>مكتبة رقمية شاملة تضم كتباً ومراجع وبحوثاً قانونية في مختلف التخصصات.</p>
        </div>

        <div class="feature-card reveal">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
              <path d="M14 2v6h6M9 15l2 2 4-4" />
            </svg>
          </div>
          <h3>واجبات وتقييم</h3>
          <p>واجبات دورية بتقييم فوري للأسئلة الموضوعية وملاحظات تفصيلية من الأستاذ.</p>
        </div>

        <div class="feature-card reveal">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 20V10M18 20V4M6 20v-4" />
            </svg>
          </div>
          <h3>متابعة الأداء</h3>
          <p>لوحات معلومات دقيقة تعرض درجاتك ونقاطك وحضورك وتقدّمك في كل مقرر.</p>
        </div>

        <div class="feature-card reveal">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01" />
            </svg>
          </div>
          <h3>مساعد ذكي</h3>
          <p>مساعد ذكاء اصطناعي متاح على مدار الساعة للإجابة على استفساراتك العلمية.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ المسارات الأكاديمية ============ -->
  <section class="section" id="tracks">
    <div class="container">
      <div class="section-head reveal">
        <div class="section-eyebrow">الأقسام الأكاديمية</div>
        <h2 class="section-title">
          أربعة أقسام <span class="accent">منفصلة ومختلطة</span> لبناء مستقبلك القانوني
        </h2>
        <p class="section-sub">
          مسارا البكالوريوس منفصلان (طلاب لوحدهم وطالبات لوحدهنّ)، وثلاثة أقسام مختلطة تعد الطلاب والطالبات معاً
        </p>
      </div>

      <div class="tracks-grid">
        <div class="track-card bachelor reveal">
          <div class="track-head">
            <div class="track-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3L2 9l10 6 10-6-10-6z" />
                <path d="M6 11v5c0 1.5 3 3 6 3s6-1.5 6-3v-5" />
                <path d="M22 9v6" />
              </svg>
            </div>
            <div>
              <h3>مسار الطلاب</h3>
              <span>بكالوريوس — نظام الدراسة المنفصلة</span>
            </div>
          </div>
          <p>
            قسم مخصص للطلاب الذكور فقط (نظام الدراسة المنفصلة)، بمنهج أكاديمي متكامل في
            العلوم القانونية والعدلية حتى التخرج.
          </p>
          <div class="track-levels">
            <span class="level-badge">المستوى الأول</span>
            <span class="level-badge">المستوى الثاني</span>
            <span class="level-badge">المستوى الثالث</span>
            <span class="level-badge">المستوى الرابع</span>
          </div>
        </div>

        <div class="track-card bachelor reveal">
          <div class="track-head">
            <div class="track-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3L2 9l10 6 10-6-10-6z" />
                <path d="M6 11v5c0 1.5 3 3 6 3s6-1.5 6-3v-5" />
                <path d="M22 9v6" />
              </svg>
            </div>
            <div>
              <h3>مسار الطالبات</h3>
              <span>بكالوريوس — نظام الدراسة المنفصلة</span>
            </div>
          </div>
          <p>
            قسم مخصص للطالبات فقط (نظام الدراسة المنفصلة)، بنفس المنهج الرصين في
            العلوم القانونية والعدلية مع خصوصية البيئة التعليمية المناسبة.
          </p>
          <div class="track-levels">
            <span class="level-badge">المستوى الأول</span>
            <span class="level-badge">المستوى الثاني</span>
            <span class="level-badge">المستوى الثالث</span>
            <span class="level-badge">المستوى الرابع</span>
          </div>
        </div>

        <div class="track-card equiv reveal">
          <div class="track-head">
            <div class="track-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                <path d="M6 12v5c3 3 9 3 12 0v-5" />
              </svg>
            </div>
            <div>
              <h3>قسم المعادلة</h3>
              <span>نظام الدراسة المختلطة — لحملة الشهادات</span>
            </div>
          </div>
          <p>
            مسار مختلط (طلاب وطالبات معاً) مخصص لحملة الشهادات الجامعية في تخصصات أخرى
            الراغبين بمعادلة في العلوم القانونية، بخطة دراسية مكثفة ومرنة.
          </p>
          <div class="track-levels">
            <span class="level-badge">مسار مكثّف</span>
            <span class="level-badge">خطة مرنة</span>
            <span class="level-badge">شهادة معتمدة</span>
          </div>
        </div>

        <div class="track-card equiv reveal">
          <div class="track-head">
            <div class="track-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v4" />
              </svg>
            </div>
            <div>
              <h3>قسم طلاب من الخارج</h3>
              <span>نظام الدراسة المختلطة — للطلاب الدوليين</span>
            </div>
          </div>
          <p>
            قسم مختلط (طلاب وطالبات معاً) للطلاب من خارج العراق الراغبين بدراسة
            العلوم القانونية والعدلية في بيئتنا العربية والأكاديمية، بنفس نظام المعادلة.
          </p>
          <div class="track-levels">
            <span class="level-badge">طلاب وطالبات</span>
            <span class="level-badge">برنامج مكثّف</span>
            <span class="level-badge">شهادة معتمدة</span>
          </div>
        </div>

        <div class="track-card equiv reveal">
          <div class="track-head">
