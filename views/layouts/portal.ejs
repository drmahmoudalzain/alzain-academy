<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> — <%= settings.platform_name || 'أكاديمية آل الزين' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@300;400;500;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/views/student-dashboard.css">
  <% if (typeof pageCss !== 'undefined' && pageCss) { %><link rel="stylesheet" href="<%= pageCss %>"><% } %>
  <link rel="stylesheet" href="/css/portal-theme.css">
</head>
<body class="portal portal-<%= portal.key %>"<%- typeof bodyAttrs !== 'undefined' && bodyAttrs ? ' ' + bodyAttrs : '' %>>

  <div class="app">

    <aside class="sidebar" id="sidebar">
      <div class="sidebar-brand">
        <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M32 6v46"/>
          <path d="M20 52h24"/>
          <circle cx="32" cy="10" r="3" fill="currentColor" stroke="none"/>
          <path d="M10 18h44"/>
          <path d="M10 18L4 32h12L10 18z"/>
          <path d="M54 18L48 32h12L54 18z"/>
          <path d="M4 32a6 6 0 0 0 12 0"/>
          <path d="M48 32a6 6 0 0 0 12 0"/>
        </svg>
        <div class="sidebar-brand-text">
          <strong>أكاديمية آل الزين</strong>
          <small>للعلوم القانونية والعدلية</small>
        </div>
      </div>

      <div class="sidebar-portal-badge"><%= portal.label %></div>

      <nav class="sidebar-nav" aria-label="التنقل الرئيسي">
        <% for (const group of (nav || [])) { %>
          <div class="nav-section"><%= group.section %></div>
          <% for (const item of group.items) { %>
            <% const active = item.href === portal.home ? currentPath === item.href : (currentPath === item.href || currentPath.startsWith(item.href + '/')); %>
            <% const badge = item.badgeKey ? ((navBadges || {})[item.badgeKey] || 0) : 0; %>
            <a href="<%= item.method === 'post' ? '#' : item.href %>"
               class="nav-item <%= active ? 'active' : '' %>"
               <% if (active) { %>aria-current="page"<% } %>
               <% if (item.method === 'post') { %>data-logout-link<% } %>>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <%- include('../partials/nav-icon', { icon: item.icon }) %>
              </svg>
              <%= item.label %>
              <% if (badge > 0) { %><span class="nav-badge <%= item.badgeKey === 'assignments' ? 'red' : 'green' %>"><%= badge %></span><% } %>
            </a>
          <% } %>
        <% } %>
      </nav>

      <div class="sidebar-user">
        <div class="user-card">
          <div class="user-avatar"><%= (user.name || '؟').trim().charAt(0) %></div>
          <div class="user-info">
            <strong><%= user.name %></strong>
            <span><%= user.university_id || user.position || portal.short %></span>
          </div>
          <form method="post" action="/logout" class="sidebar-logout-form">
            <button type="submit" class="sidebar-logout" aria-label="تسجيل الخروج" title="تسجيل الخروج">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <%- include('../partials/nav-icon', { icon: 'logout' }) %>
              </svg>
            </button>
          </form>
        </div>
      </div>
    </aside>

    <div class="sidebar-overlay" id="sidebarOverlay" hidden></div>

    <div class="main">
      <header class="topbar">
        <div class="topbar-left">
          <button class="menu-btn" id="menuBtn" aria-label="فتح القائمة" aria-expanded="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <%- include('../partials/nav-icon', { icon: 'menu' }) %>
            </svg>
          </button>

          <div class="topbar-title">
            <h1><%= pageTitle %></h1>
            <div class="breadcrumb">
              <span>الرئيسية</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <%- include('../partials/nav-icon', { icon: 'chevron' }) %>
              </svg>
              <span><%= pageTitle %></span>
            </div>
          </div>
        </div>

        <% const hasSearch = typeof searchAction !== 'undefined' && searchAction; %>
        <% if (hasSearch) { %>
          <form class="search-box" method="get" action="<%= searchAction %>" role="search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <%- include('../partials/nav-icon', { icon: 'search' }) %>
            </svg>
            <input type="search" name="q" value="<%= typeof searchValue !== 'undefined' ? searchValue : '' %>" placeholder="<%= typeof searchPlaceholder !== 'undefined' ? searchPlaceholder : 'ابحث...' %>" aria-label="بحث" />
          </form>
        <% } else { %>
          <div class="search-box search-box--static">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <%- include('../partials/nav-icon', { icon: 'search' }) %>
            </svg>
            <input type="search" placeholder="ابحث في المنصة..." aria-label="بحث" disabled />
          </div>
        <% } %>

        <div class="topbar-actions">
          <a class="icon-btn" href="/account" aria-label="الحساب">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <%- include('../partials/nav-icon', { icon: 'settings' }) %>
            </svg>
          </a>
          <div class="topbar-divider"></div>
          <form method="post" action="/logout" class="inline-form">
            <button class="icon-btn" type="submit" aria-label="تسجيل الخروج" title="تسجيل الخروج">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <%- include('../partials/nav-icon', { icon: 'logout' }) %>
              </svg>
            </button>
          </form>
        </div>
      </header>

      <main class="content">
        <%- body %>
      </main>
    </div>
  </div>

  <script src="/js/portal.js" defer></script>
  <% if (typeof pageScripts !== 'undefined' && pageScripts) { for (const src of pageScripts) { %>
    <script src="<%= src %>" defer></script>
  <% } } %>
</body>
</html>
