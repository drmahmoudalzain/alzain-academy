<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> — <%= settings.platform_name %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="theme-app theme-<%= portal ? portal.theme : 'owner' %>">
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand brand--compact" href="<%= portal ? portal.home : '/' %>">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3.5v17" />
            <path d="M6.5 6.5h11" />
            <path d="M8.2 6.5 5.5 13h5.4L8.2 6.5Z" />
            <path d="M15.8 6.5 13.1 13h5.4l-2.7-6.5Z" />
            <path d="M8.5 20.5h7" />
          </svg>
        </span>
        <span class="brand-text">
          <span class="brand-title"><%= settings.platform_name %></span>
          <span class="brand-sub"><%= portal ? portal.label : settings.watermark_latin %></span>
        </span>
      </a>

      <nav class="topnav" aria-label="التنقل">
        <a class="topnav-link <%= currentPath === (portal && portal.home) ? 'is-active' : '' %>"
           href="<%= portal ? portal.home : '/' %>">الرئيسية</a>
        <a class="topnav-link <%= currentPath.startsWith('/account') ? 'is-active' : '' %>"
           href="/account">حسابي</a>
      </nav>

      <% if (user) { %>
        <div class="userbox">
          <span class="userbox-avatar" aria-hidden="true"><%= user.name.trim().charAt(0) %></span>
          <span class="userbox-meta">
            <strong><%= user.name %></strong>
            <small><%= portal ? portal.label : (user.role === 'teacher' ? 'أستاذ' : 'طالب') %></small>
          </span>
          <form method="post" action="/logout" class="inline-form">
            <button type="submit" class="btn btn-ghost btn-sm">خروج</button>
          </form>
        </div>
      <% } %>
    </div>
  </header>

  <main class="app-main">
    <%- body %>
  </main>

  <footer class="app-footer">
    <span><%= settings.platform_name %> — <%= settings.watermark_latin %></span>
    <span><%= settings.watermark_text %></span>
  </footer>

  <script src="/js/app.js" defer></script>
</body>
</html>
