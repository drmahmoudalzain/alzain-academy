<section class="page-head">
  <div>
    <p class="eyebrow"><%= portal.label %></p>
    <h1 class="page-title">حسابي</h1>
    <p class="page-sub">بياناتك الشخصية وكلمة المرور.</p>
  </div>
</section>

<% if (mustChange) { %>
  <div class="alert alert--notice">
    يُنصح بتغيير كلمة المرور المؤقتة الآن، ثم متابعة العمل.
  </div>
<% } %>
<% if (notice) { %>
  <div class="alert alert--success"><%= notice %></div>
<% } %>
<% if (error) { %>
  <div class="alert alert--error" role="alert"><%= error %></div>
<% } %>

<div class="grid-2">
  <section class="panel">
    <header class="panel-head">
      <h2>الملف الشخصي</h2>
      <p>يظهر اسمك للأساتذة والزملاء داخل المنصة.</p>
    </header>

    <form method="post" action="/account/profile" class="form">
      <label class="field">
        <span class="field-label">الاسم الكامل</span>
        <input class="input" type="text" name="name" value="<%= profile.name %>" required maxlength="120">
      </label>
      <label class="field">
        <span class="field-label">البريد الإلكتروني</span>
        <input class="input" type="email" name="email" value="<%= profile.email %>" maxlength="160">
      </label>
      <label class="field">
        <span class="field-label">رقم الجوال</span>
        <input class="input" type="text" name="phone" value="<%= profile.phone %>" maxlength="30" dir="ltr">
      </label>
      <button class="btn btn-primary" type="submit">حفظ الملف الشخصي</button>
    </form>
  </section>

  <section class="panel">
    <header class="panel-head">
      <h2>كلمة المرور</h2>
      <p>8 أحرف على الأقل، ويُفضّل خليط من الحروف والأرقام.</p>
    </header>

    <form method="post" action="/account/password" class="form">
      <label class="field">
        <span class="field-label">كلمة المرور الحالية</span>
        <input class="input" type="password" name="current" autocomplete="current-password" required>
      </label>
      <label class="field">
        <span class="field-label">كلمة المرور الجديدة</span>
        <input class="input" type="password" name="next" autocomplete="new-password" minlength="8" required>
      </label>
      <label class="field">
        <span class="field-label">تأكيد كلمة المرور</span>
        <input class="input" type="password" name="confirm" autocomplete="new-password" minlength="8" required>
      </label>
      <button class="btn btn-primary" type="submit">تغيير كلمة المرور</button>
    </form>
  </section>
</div>
