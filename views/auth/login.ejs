<div class="login-shell">

  <main class="form-side">

    <div class="form-topbar">
      <a href="/" class="back-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
        العودة للرئيسية
      </a>

      <div class="portal-switcher" role="tablist" aria-label="تبديل البوابة">
        <% for (const [key, item] of Object.entries(portals)) { %>
          <% if (key === portal.key) { %>
            <span class="active" aria-current="page"><%= item.short %></span>
          <% } else { %>
            <a href="/login?role=<%= key %>"><%= item.short %></a>
          <% } %>
        <% } %>
      </div>
    </div>

    <div class="form-card">

      <div class="role-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 7l9-4 9 4v6c0 4.5-3.5 8-9 9-5.5-1-9-4.5-9-9V7z"/>
          <path d="M9 12l2 2 4-4"/>
        </svg>
        <%= copy.badge %>
      </div>

      <h1><%= copy.heading %></h1>
      <p class="form-sub"><%= copy.sub %></p>

      <% if (error) { %>
        <div class="alert error" role="alert">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 8v4M12 16h.01"/>
          </svg>
          <div>
            <strong>تعذر تسجيل الدخول</strong>
            <span><%= error %></span>
          </div>
        </div>
      <% } %>

      <% if (notice) { %>
        <div class="alert info" role="status">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 16v-4M12 8h.01"/>
          </svg>
          <div>
            <strong>ملاحظة</strong>
            <span><%= notice %></span>
          </div>
        </div>
      <% } %>

      <form id="loginForm" method="post" action="/login" novalidate>
        <input type="hidden" name="portal" value="<%= portal.key %>">
        <% if (next) { %><input type="hidden" name="next" value="<%= next %>"><% } %>

        <div class="field">
          <label for="identifier">
            <%= copy.identifierLabel %>
          </label>
          <div class="input-wrap">
            <span class="input-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="5" width="20" height="14" rx="2"/>
                <path d="M2 10h20M6 15h4"/>
              </svg>
            </span>
            <input
              type="text"
              id="identifier"
              name="identifier"
              value="<%= identifier %>"
              placeholder="<%= copy.identifierPlaceholder %>"
              autocomplete="username"
              spellcheck="false"
              required
              autofocus
            />
          </div>
          <span class="field-hint"><%= copy.identifierHint %></span>
        </div>

        <div class="field">
          <label for="password">كلمة المرور</label>
          <div class="input-wrap password">
            <span class="input-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
            </span>
            <input
              type="password"
              id="password"
              name="password"
              placeholder="••••••••••"
              autocomplete="current-password"
              required
            />
            <button type="button" class="toggle-pwd" id="togglePwd" aria-label="إظهار كلمة المرور" aria-pressed="false">
              <svg class="eye-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
              <svg class="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                <path d="M1 1l22 22"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="form-row">
          <span class="session-note">تبقى الجلسة فعّالة لمدة سبعة أيام على هذا الجهاز.</span>
          <a href="/" class="forgot">العودة للرئيسية</a>
        </div>

        <button type="submit" class="submit-btn" id="submitBtn">
          <span class="btn-text">تسجيل الدخول</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </button>
      </form>

      <div class="divider-or">أو</div>

      <div class="register-hint">
        <span><%= portal.key === 'student' ? 'طالب جديد؟' : 'تحتاج حساباً؟' %></span>
        <a href="mailto:admin@lectures.local">تواصل مع إدارة الأكاديمية</a>
      </div>

      <div class="security-note">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="M9 12l2 2 4-4"/>
        </svg>
        <span><%= copy.note %></span>
      </div>

    </div>

    <div class="form-footer">
      <span>© 2026 أكاديمية آل الزين</span>
      <span class="sep">•</span>
      <span><%= copy.footerNote %></span>
    </div>
  </main>

  <aside class="visual-side" aria-hidden="true">

    <div class="visual-bg">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
      <div class="pattern"></div>
    </div>

    <div class="visual-top">
      <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M32 6v46"/>
        <path d="M20 52h24"/>
        <circle cx="32" cy="10" r="3" fill="currentColor" stroke="none"/>
        <path d="M10 18h44"/>
        <path d="M10 18L4 32h12L10 18z"/>
        <path d="M54 18L48 32h12L54 18z"/>
        <path d="M4 32a6 6 0 0 0 12 0"/>
        <path d="M48 32a6 6 0 0 0 12 0"/>
      </svg>
      <span>أكاديمية آل الزين</span>
    </div>

    <div class="visual-content">

      <div class="emblem-large">
        <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M32 6v46"/>
          <path d="M20 52h24"/>
          <circle cx="32" cy="10" r="3.2" fill="currentColor" stroke="none"/>
          <path d="M10 18h44"/>
          <path d="M10 18L4 32h12L10 18z"/>
          <path d="M54 18L48 32h12L54 18z"/>
          <path d="M4 32a6 6 0 0 0 12 0"/>
          <path d="M48 32a6 6 0 0 0 12 0"/>
        </svg>
      </div>

      <h2><%= copy.visualTitle %></h2>
      <div class="green-line"></div>
      <p class="visual-lead"><%= copy.visualLead %></p>

      <ul class="privileges">
        <% for (const [title, text] of copy.privileges) { %>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 6L9 17l-5-5"/>
            </svg>
            <div>
              <strong><%= title %></strong>
              <span><%= text %></span>
            </div>
          </li>
        <% } %>
      </ul>

      <div class="points-highlight">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <%= copy.pointsNote %>
      </div>
    </div>

    <div class="visual-footer">
      <div class="seal">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
          <path d="M22 4L12 14l-3-3"/>
        </svg>
        <div>
          <strong>تعلّم متكامل</strong>
          <span>محاضرات + تطبيق + تقييم</span>
        </div>
      </div>
      <div class="seal gold">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="M9 12l2 2 4-4"/>
        </svg>
        <div>
          <strong>وصول محمي</strong>
          <span>جلسات مشفّرة وفصل صارم</span>
        </div>
      </div>
    </div>

  </aside>
</div>

<script src="/js/login.js" defer></script>
