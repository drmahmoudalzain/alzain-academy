<section class="page-header">
  <div class="page-header-info">
    <h2>المكتبة</h2>
    <p>كتب ومراجع وبحوث ودروس فيديو في العلوم القانونية والعدلية — مصنّفة حسب التخصص.</p>
  </div>
  <div class="page-header-actions">
    <% if (canUpload) { %><a class="btn btn-primary" href="/library/new">إضافة عنصر</a><% } %>
  </div>
</section>

<!-- الأقسام -->
<div class="mini-stats" style="margin-bottom:20px;">
  <% for (const section of sections) { %>
    <div class="mini-stat all">
      <div class="mini-stat-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><path d="M9 7h6M9 11h6"/></svg>
      </div>
      <div class="mini-stat-body">
        <div class="mini-stat-label"><%= section.name %></div>
        <div class="mini-stat-value"><%= section.count %> <small>عنصر</small></div>
      </div>
    </div>
  <% } %>
</div>

<!-- العناصر الحديثة -->
<% if (items.length) { %>
  <div class="table-card">
    <div class="table-card-head"><h3>أحدث عناصر المكتبة</h3></div>
    <div class="table-scroll">
      <table class="data-table">
        <thead><tr><th>العنوان</th><th>القسم</th><th>النوع</th><th>سنة النشر</th><th></th></tr></thead>
        <tbody>
          <% for (const item of items) { %>
            <tr>
              <td><strong><a href="/library/item/<%= item.id %>" style="color:inherit;text-decoration:none;"><%= item.title %></a></strong></td>
              <td><%= item.sectionName %></td>
              <td><span class="chip"><%= item.kind === 'book' ? 'كتاب' : (item.kind === 'research' ? 'بحث' : (item.kind === 'video' ? 'فيديو' : 'رابط')) %></span></td>
              <td><%= item.publish_year || '—' %></td>
              <td><a class="chip" href="/library/item/<%= item.id %>">عرض</a></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
<% } else { %>
  <div class="empty-state"><h3>المكتبة فارغة</h3><p>لم تُضف أي كتب أو بحوث أو دروس بعد.</p></div>
<% } %>
