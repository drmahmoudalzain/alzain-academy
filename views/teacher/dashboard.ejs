<!-- بطاقة الترحيب -->
<section class="welcome-card">
  <div class="welcome-content">
    <div class="welcome-tag">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7l9-4 9 4v6c0 4.5-3.5 8-9 9-5.5-1-9-4.5-9-9V7z"/><path d="M9 12l2 2 4-4"/></svg>
      أهلاً بأستاذنا
    </div>
    <h2>يوم موفق، <span class="name"><%= user.name.split(' ')[0] %></span></h2>
    <p>إليك نظرة على مقرراتك وعدد طلابك ونشاط محاضراتك الأخيرة.</p>
    <div class="welcome-actions">
      <a class="btn btn-gold" href="/teacher/lectures">إدارة المحاضرات</a>
      <a class="btn btn-outline" href="/teacher/courses">مقرراتي</a>
    </div>
  </div>
</section>

<section class="stats-grid">
  <div class="stat-card students">
    <div class="stat-head">
      <div class="stat-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      </div>
    </div>
    <div class="stat-label">مقرراتي</div>
    <div class="stat-value"><%= stats.courses %></div>
  </div>
  <div class="stat-card attendance">
    <div class="stat-head">
      <div class="stat-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </div>
    </div>
    <div class="stat-label">الطلاب المسجلون</div>
    <div class="stat-value"><%= stats.students %></div>
  </div>
  <div class="stat-card points">
    <div class="stat-head">
      <div class="stat-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
      </div>
    </div>
    <div class="stat-label">المحاضرات</div>
    <div class="stat-value"><%= stats.lectures %></div>
  </div>
  <div class="stat-card exams">
    <div class="stat-head">
      <div class="stat-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
      </div>
    </div>
    <div class="stat-label">الاختبارات</div>
    <div class="stat-value"><%= stats.exams %></div>
  </div>
</section>

<section class="dashboard-grid">
  <div class="stack">
    <!-- مقرراتي -->
    <div class="card">
      <div class="card-header">
        <div class="card-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          مقرراتي
        </div>
        <a href="/teacher/courses" class="card-link">الكل</a>
      </div>
      <div class="card-body">
        <% if (courses.length) { %>
          <div class="courses-list">
            <% for (const course of courses) { %>
              <a class="course-item" href="/teacher/courses" style="text-decoration:none;color:inherit;">
                <div class="course-icon" style="--course-color:<%= course.color || '#123A63' %>;"><span><%= course.code.slice(0, 2) %></span></div>
                <div class="course-info">
                  <h4><%= course.title %></h4>
                  <div class="course-meta">
                    <span><%= course.code %></span>
                    <span><%= course.studentCount %> طلاب · <%= course.lectureCount %> محاضرات</span>
                  </div>
                </div>
              </a>
            <% } %>
          </div>
        <% } else { %>
          <div class="empty-state" style="border:0;"><h3>لا توجد مقررات</h3><p>لم تُسنَد إليك مقررات بعد.</p></div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="stack">
    <!-- آخر المحاضرات -->
    <div class="card">
      <div class="card-header">
        <div class="card-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
          آخر المحاضرات
        </div>
        <a href="/teacher/lectures" class="card-link">الكل</a>
      </div>
      <div class="card-body no-pad">
        <% if (lectures.length) { %>
          <div class="lectures-list">
            <% for (const lecture of lectures) { const md = format.monthDay(lecture.scheduled_at); %>
              <div class="lecture-item">
                <div class="lecture-date">
                  <span class="day"><%= md.day %></span>
                  <span class="month"><%= md.month %></span>
                </div>
                <div class="lecture-info">
                  <h4><%= lecture.title %></h4>
                  <div class="lecture-sub">
                    <span><%= lecture.courses ? lecture.courses.code : '' %></span>
                    <span><%= format.formatTime(lecture.scheduled_at) %></span>
                  </div>
                </div>
                <span class="lecture-type <%= lecture.lecture_type %>"><%= lecture.lecture_type === 'direct' ? 'مباشر' : (lecture.lecture_type === 'online' ? 'أونلاين' : 'مسجل') %></span>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <div class="empty-state" style="border:0;"><h3>لا توجد محاضرات</h3><p>لم تُعلّق محاضرات بعد.</p></div>
        <% } %>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <div class="card-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          إدارة التدريس
        </div>
      </div>
      <div class="quick-actions">
        <a class="action-btn" href="/teacher/courses">
          <div class="icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          </div>
          <span>مقرراتي</span>
        </a>
        <a class="action-btn green" href="/teacher/lectures">
          <div class="icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
          </div>
          <span>المحاضرات</span>
        </a>
        <a class="action-btn blue" href="/teacher/exams">
          <div class="icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
          </div>
          <span>الاختبارات</span>
        </a>
        <a class="action-btn" href="/teacher/assignments">
          <div class="icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          </div>
          <span>الواجبات</span>
        </a>
        <a class="action-btn green" href="/notifications">
          <div class="icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          </div>
          <span>الإشعارات</span>
        </a>
        <a class="action-btn blue" href="/account">
          <div class="icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <span>حسابي</span>
        </a>
      </div>
    </div>
  </div>
</section>
