<section class="page-header">
  <div class="page-header-info">
    <h2>المحاضرات</h2>
    <p>كل المحاضرات في مقرراتك — مع عدد الحضور لكل محاضرة.</p>
  </div>
</section>

<div class="filter-tabs" style="margin-bottom:16px;">
  <a class="filter-tab <%= type === 'all' ? 'active' : '' %>" href="/teacher/lectures">الكل</a>
  <a class="filter-tab <%= type === 'direct' ? 'active' : '' %>" href="/teacher/lectures?type=direct">مباشر</a>
  <a class="filter-tab <%= type === 'online' ? 'active' : '' %>" href="/teacher/lectures?type=online">أونلاين</a>
  <a class="filter-tab <%= type === 'recorded' ? 'active' : '' %>" href="/teacher/lectures?type=recorded">مسجل</a>
</div>

<% if (lectures.length) { %>
  <div class="table-card">
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr><th>المحاضرة</th><th>المقرر</th><th>الموعد</th><th>النوع</th><th>الحضور</th><th>رمز الحضور</th></tr>
        </thead>
        <tbody>
          <% for (const lecture of lectures) { %>
            <tr>
              <td><strong><%= lecture.title %></strong></td>
              <td><%= lecture.course ? `${lecture.course.code}` : '—' %></td>
              <td><%= format.formatDateTime(lecture.scheduled_at) %></td>
              <td><span class="chip"><%= lecture.lecture_type === 'direct' ? 'مباشر' : (lecture.lecture_type === 'online' ? 'أونلاين' : 'مسجل') %></span></td>
              <td><%= lecture.attendanceCount %> حضور</td>
              <td><%= lecture.attendance_open && lecture.attendance_code ? 'مفتوح' : 'مغلق' %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
<% } else { %>
  <div class="empty-state"><h3>لا توجد محاضرات</h3><p>جرّب تغيير الفلتر أو البحث.</p></div>
<% } %>
