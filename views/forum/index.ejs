<section class="forum-layout">

  <!-- قائمة الغرف -->
  <aside class="forum-rooms" aria-label="غرف المنتدى">
    <div class="forum-rooms-head">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:18px;height:18px;"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      <div>
        <strong>غرف المنتدى</strong>
        <small id="roomCount"><%= rooms.length %> غرفة</small>
      </div>
    </div>

    <nav class="forum-rooms-list" aria-label="اختيار الغرفة">
      <% for (const room of rooms) { %>
        <a class="forum-room<%= activeRoom && activeRoom.id === room.id ? ' active' : '' %>"
           href="/forum?room=<%= room.id %>"
           data-room-id="<%= room.id %>"
           data-room-name="<%= room.name %>">
          <div class="forum-room-icon <%= room.kind %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:17px;height:17px;"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <div class="forum-room-info">
            <strong><%= room.name %></strong>
            <span><%= room.kind === 'general' ? 'الساحة العامة' : 'غرفة المقرر' %></span>
          </div>
          <span class="forum-room-dot" aria-hidden="true"></span>
        </a>
      <% } %>
      <% if (!rooms.length) { %>
        <div class="empty-state" style="border:0;padding:20px;"><p>لا توجد غرف متاحة لك بعد.</p></div>
      <% } %>
    </nav>
  </aside>

  <!-- مساحة الدردشة -->
  <main class="forum-chat">
    <% if (activeRoom) { %>
      <header class="forum-chat-head">
        <div class="forum-chat-title">
          <span class="room-badge"><%= activeRoom.kind === 'general' ? 'عام' : 'مقرر' %></span>
          <div>
            <h2 id="activeRoomName"><%= activeRoom.name %></h2>
            <span class="forum-chat-sub"><span id="presenceCount">1</span> متصل الآن · <span id="messageCount">—</span> رسالة</span>
          </div>
        </div>
        <div class="forum-chat-actions">
          <button type="button" class="icon-btn" id="voiceCallBtn" aria-label="مكالمة صوتية" title="مكالمة صوتية">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:19px;height:19px;"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v1a7 7 0 0 1-14 0v-1M12 19v3M8 22h8"/></svg>
          </button>
          <button type="button" class="icon-btn" id="videoCallBtn" aria-label="مكالمة فيديو" title="مكالمة فيديو">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:19px;height:19px;"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
          </button>
        </div>
      </header>

      <!-- منطقة الرسائل -->
      <div class="forum-messages" id="messagesList" role="log" aria-live="polite" aria-label="رسائل الغرفة">
        <div id="messagesEmpty" class="empty-state" style="border:0;padding:36px;" hidden>
          <h3>كن أول من يشارك</h3>
          <p>هذه الغرفة هادئة — ابدأ نقاشاً علمياً رصيناً.</p>
        </div>
      </div>

      <!-- محرر الرسالة -->
      <form class="forum-composer" id="composerForm" method="post" action="/forum/messages" autocomplete="off">
        <input type="hidden" name="room_id" value="<%= activeRoom.id %>">
        <div class="composer-input-wrap">
          <textarea id="messageInput" name="body" rows="1" maxlength="1000" placeholder="اكتب رسالتك..." aria-label="الرسالة" required></textarea>
          <span class="composer-hint"><span id="charCount">0</span> / 1000</span>
        </div>
        <button type="submit" class="btn btn-gold forum-send" aria-label="إرسال">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:18px;height:18px;"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
          <span class="send-label">إرسال</span>
        </button>
      </form>
    <% } else { %>
      <div class="empty-state" style="border:0;padding:48px;">
        <h3>اختر غرفة</h3>
        <p>اختر غرفة من القائمة للبدء بالمحادثة.</p>
      </div>
    <% } %>
  </main>
</section>

<!-- نافذة المكالمة (صوت/فيديو) -->
<div class="call-overlay" id="callOverlay" hidden role="dialog" aria-modal="true" aria-labelledby="callRoomName">
  <div class="call-panel">
    <header class="call-head">
      <div class="call-room-info">
        <span class="call-live-dot" aria-hidden="true"></span>
        <div>
          <strong id="callRoomName">مكالمة</strong>
          <span class="call-state" id="callState">جارية · <span id="callCount">1</span> مشارك</span>
        </div>
      </div>
      <button type="button" class="call-leave" id="callLeaveBtn" aria-label="إنهاء المكالمة">
        إنهاء المكالمة
      </button>
    </header>
    <div class="video-grid" id="videoGrid" aria-label="المشاركون"></div>
    <footer class="call-controls">
      <button type="button" class="call-toggle" id="toggleMicBtn" aria-pressed="true" aria-label="تبديل الصوت">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:22px;height:22px;"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v1a7 7 0 0 1-14 0v-1M12 19v3M8 22h8"/></svg>
      </button>
      <button type="button" class="call-toggle" id="toggleCamBtn" aria-pressed="true" aria-label="تبديل الفيديو">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:22px;height:22px;"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
      </button>
    </footer>
  </div>
</div>

<script>
  window.FORUM_CONFIG = {
    activeRoomId: <%= activeRoom ? activeRoom.id : 'null' %>,
    currentUserId: <%= currentUser.id %>,
    currentUserName: <%- JSON.stringify(currentUser.name) %>,
    rooms: [
      <% for (const room of rooms) { %>{ id: <%= room.id %>, name: <%- JSON.stringify(room.name) %> },<% } %>
    ],
  };
</script>
<script src="/js/forum.js" defer></script>
