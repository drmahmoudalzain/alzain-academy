<section class="page-header">
  <div class="page-header-info">
    <h2>إضافة مستخدم</h2>
    <p>يُنشأ حساب بكلمة مرور مؤقتة ويُطلب من صاحبه تغييرها عند أول دخول.</p>
  </div>
</section>

<% if (error) { %>
  <div class="alert-inline error" role="alert">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
    <div><%= error %></div>
  </div>
<% } %>

<div class="role-choice" role="group" aria-label="نوع الحساب المراد إنشاؤه">
  <a class="btn role-choice-btn <%= role === 'student' ? 'btn-primary' : 'btn-secondary' %>" href="/owner/users/new?role=student">
    <strong>طالب</strong>
    <span>حساب دراسي داخل أحد المسارات الأكاديمية.</span>
  </a>
  <a class="btn role-choice-btn <%= role === 'teacher' ? 'btn-primary' : 'btn-secondary' %>" href="/owner/users/new?role=teacher">
    <strong>أستاذ</strong>
    <span>حساب هيئة تدريس لإدارة المقررات والدرجات.</span>
  </a>
  <a class="btn role-choice-btn <%= role === 'assistant' ? 'btn-primary' : 'btn-secondary' %>" href="/owner/users/new?role=assistant">
    <strong>تعيين مساعد إداري</strong>
    <span>دور مستقل للعرض والتصدير فقط، لا يظهر ضمن الطلاب أو الأساتذة.</span>
  </a>
</div>

<form method="post" action="/owner/users" class="table-card">
  <input type="hidden" name="role" value="<%= role %>">
  <div class="side-card-body" style="padding:24px;">
    <div class="form-grid">
      <label>الاسم الكامل *
        <input type="text" name="name" required maxlength="120" placeholder="مثال: أحمد سالم باوزير">
      </label>

      <% if (role === 'student') { %>
        <div class="form-grid" style="grid-template-columns: 1.2fr 1fr;">
          <label>الرقم الجامعي <span class="muted">(اختياري)</span>
            <input type="text" name="university_id" maxlength="20" dir="ltr" style="text-align:left;" placeholder="2024009">
          </label>
          <label>البريد الإلكتروني <span class="muted">(اختياري)</span>
            <input type="email" name="email" maxlength="160" dir="ltr" style="text-align:left;" placeholder="student@example.com">
          </label>
        </div>
        <div class="form-grid" style="grid-template-columns: 1fr 1fr;">
          <label>القسم الأكاديمي
            <select name="track">
              <%- include('../partials/track-options', { currentTrack: 'bachelor_m', forStudent: true }) %>
            </select>
          </label>
          <label>المستوى
            <select name="level">
              <option value="1">المستوى الأول</option>
              <option value="2">المستوى الثاني</option>
              <option value="3">المستوى الثالث</option>
              <option value="4">المستوى الرابع</option>
            </select>
          </label>
        </div>
      <% } else { %>
        <div class="form-grid" style="grid-template-columns: 1fr 1fr;">
          <label>البريد الوظيفي
            <input type="email" name="email" maxlength="160" dir="ltr" style="text-align:left;" placeholder="<%= role === 'assistant' ? 'assistant@example.com' : 'teacher@example.com' %>">
          </label>
          <label>الترتيب/اللقب
            <input type="text" name="position" maxlength="80" placeholder="<%= role === 'assistant' ? 'مثال: مساعد إداري' : 'مثال: أستاذ مساعد' %>">
          </label>
        </div>
      <% } %>
    </div>

    <% if (role === 'assistant') { %>
      <div class="alert-inline info" role="note" style="margin-top:16px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
        <div>المساعد الإداري حساب مستقل بصلاحية <strong>عرض بيانات الطلاب وتصديرها فقط</strong>. لا يستطيع إنشاء المستخدمين أو تعديل بياناتهم أو إعادة تعيين كلمات المرور أو إيقاف الحسابات.</div>
      </div>
    <% } %>

    <div class="alert-inline info" role="note" style="margin-top:16px;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
      <div>الاسم الرباعي والمسار يكفيان — <strong>الرمز يُولّد تلقائياً</strong> حسب المسار (BM/BF/EQ/EX/PG للطلاب، TE للأستاذ، AS للمساعد الإداري) مع كلمة مرور مؤقتة تظهر مرة واحدة فقط في بطاقة الدخول. البريد ليس للدخول — سيُدخله المستخدم بنفسه عند أول جلسة.</div>
    </div>

    <div style="display:flex;gap:10px;margin-top:16px;">
      <button type="submit" class="btn btn-primary">إنشاء الحساب</button>
      <a class="btn btn-secondary" href="/owner/users">إلغاء</a>
    </div>
  </div>
</form>

<style>
  .role-choice {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 20px;
  }
  .role-choice-btn {
    flex: 1 1 230px;
    min-height: 92px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 6px;
    padding: 16px 20px;
    text-align: right;
    line-height: 1.5;
  }
  .role-choice-btn strong { font-size: 1rem; }
  .role-choice-btn span { font-size: 0.78rem; opacity: 0.82; font-weight: 400; }
</style>
