<section class="page-header">
  <div class="page-header-info">
    <h2>تسجيل الدفعات</h2>
    <p>ارفع ملف إكسل بأسماء الطلاب، أو الصقهم يدوياً — يُولّد النظام الرمز وكلمة المرور لكل طالب ويظهرها هنا للنسخ والطباعة. الحسابات تُنشأ نشطة وجاهزة للدخول فوراً.</p>
  </div>
  <div class="page-header-actions">
    <a class="btn btn-secondary" href="/owner/users">العودة إلى المستخدمين</a>
  </div>
</section>

<% if (error) { %>
  <div class="alert-inline error" role="alert" style="margin-bottom:16px;">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
    <div><%= error %></div>
  </div>
<% } %>

<div class="table-card" id="excel" style="margin-bottom:18px;">
  <div class="table-card-head"><h3>رفع ملف إكسل — الأسماء والمسار/النوع (اختياري)</h3></div>
  <form method="post" action="/owner/users/import-excel" enctype="multipart/form-data" class="side-card-body" style="padding:20px 22px;">
    <div class="form-grid">
      <label>المسار الافتراضي
        <select name="track" required>
          <% STUDENT_TRACK_KEYS.forEach(function (key) { %>
            <option value="<%= key %>"><%= getProfile(key).label %> — <%= key %></option>
          <% }); %>
        </select>
      </label>
      <label>المستوى
        <select name="level" required>
          <% for (var i = 1; i <= 4; i += 1) { %>
            <option value="<%= i %>">المستوى <%= i %></option>
          <% } %>
        </select>
      </label>
      <label>ملف الدفعة
        <input type="file" name="roster" accept=".xlsx,.xlsm,.csv" required>
      </label>
    </div>
    <div class="alert-inline info" role="note" style="margin-top:12px;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
      <div>
        <strong>عمود 1:</strong> الاسم الرباعي (إلزامي) · <strong>عمود 2:</strong> المسار أو النوع (اختياري) · <strong>عمود 3:</strong> المستوى 1–4 (اختياري). يُتجاهل صف العنوان إن وُجد، وتُقرأ هذه الأعمدة الثلاثة فقط.
        إن تركت العمود 2 فارغةً أو لم توجد، استُخدم «المسار الافتراضي» المختار أعلاه لكل الأسماء. إن وُجدت، يُوزَّع كل اسم على مساره الخاص ويُعطى الرمز التسلسلي التالي لبادئته (<span dir="ltr">BM / BF / EQ / EX / PG</span>)، فيمكن إرسال الطلاب والطالبات في ملف واحد.
      </div>
      <div style="margin-top:8px;">
        <strong>القيم المقبولة في عمود المسار/النوع:</strong>
        <span dir="ltr">bachelor_m · BM · طلاب · ذكر</span>،
        <span dir="ltr">bachelor_f · BF · طالبات · أنثى</span>،
        <span dir="ltr">equiv · EQ · المعادلة</span>،
        <span dir="ltr">external · EX · من الخارج</span>،
        <span dir="ltr">grad · PG · الدراسات العليا</span>.
        أي قيمة غير معروفة يُبلَّغ عن سطرها ولا يُنشأ حسابها. المدعوم: <span dir="ltr">xlsx / xlsm / csv</span> حتى 2 ميجابايت و300 اسم.
      </div>
    </div>
    <div style="display:flex;gap:10px;margin-top:14px;">
      <button type="submit" class="btn btn-primary">تسجيل الدفعة</button>
      <a class="btn btn-secondary" href="/owner/users">إلغاء</a>
    </div>
  </form>
</div>

<div class="table-card" style="margin-bottom:18px;">
  <div class="table-card-head"><h3>أو: لصق الأسماء يدوياً</h3></div>
  <form method="post" action="/owner/users/import" class="side-card-body" style="padding:20px 22px;">
    <label style="font-weight:700;margin-bottom:8px;display:block;">سطر لكل طالب: <span style="direction:ltr;unicode-bidi:embed;">الاسم الرباعي , المسار , الرقم الجامعي (اختياري)</span></label>
    <textarea name="batch" rows="10" required maxlength="40000" dir="auto" style="width:100%;font-family:inherit;font-size:0.95rem;line-height:2;padding:12px 14px;border:1px solid var(--border);border-radius:10px;background:var(--bg-subtle);color:var(--text-primary);resize:vertical;" placeholder="أحمد سالم باوزير , bachelor_m , 2024009
فاطمة علي الحسني , bachelor_f
محمد عبدالله الشمري , equiv"><%= input %></textarea>

    <div class="alert-inline info" role="note" style="margin-top:12px;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
      <div>
        <strong>رموز المسارات:</strong>
        <span style="direction:ltr;unicode-bidi:embed;">bachelor_m</span> ← BM ·
        <span style="direction:ltr;unicode-bidi:embed;">bachelor_f</span> ← BF ·
        <span style="direction:ltr;unicode-bidi:embed;">equiv</span> ← EQ ·
        <span style="direction:ltr;unicode-bidi:embed;">external</span> ← EX ·
        <span style="direction:ltr;unicode-bidi:embed;">grad</span> ← PG.
        يمكن وضع <span style="direction:ltr;unicode-bidi:embed;">, ; tab</span> كفواصل بين الحقول، و<span style="direction:ltr;unicode-bidi:embed;">#</span> في بداية السطر تعني تجاهله. كل الحسابات تُنشأ طلابًا برتبة المستوى الأول وبكلمة مرور مؤقتة إلزامية التغيير.
      </div>
    </div>

    <div style="display:flex;gap:10px;margin-top:14px;">
      <button type="submit" class="btn btn-primary">إنشاء الحسابات</button>
      <a class="btn btn-secondary" href="/owner/users">إلغاء</a>
    </div>
  </form>
</div>

<% if (results && results.length) { %>
  <div class="table-card import-results" style="margin-bottom:18px;">
    <div class="table-card-head" style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;">
      <h3>تم إنشاء <%= results.length %> حسابًا</h3>
      <div style="display:flex;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" id="copyAllBtn">نسخ كل البطاقات</button>
        <button type="button" class="btn btn-secondary btn-sm" onclick="window.print()">طباعة الكل</button>
      </div>
    </div>
    <div class="table-scroll" style="padding:0 4px 12px;">
      <table class="data-table">
        <thead>
          <tr><th>#</th><th>الاسم</th><th>المسار</th><th>المستوى</th><th>الرمز</th><th>كلمة المرور المؤقتة</th><th>نسخ</th></tr>
        </thead>
        <tbody>
          <% results.forEach(function (row, i) { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= row.name %></td>
              <td><%= row.track %></td>
              <td><%= typeof row.level !== 'undefined' ? 'م' + row.level : '—' %></td>
              <td dir="ltr" style="text-align:left;"><code><%= row.platformId %></code></td>
              <td dir="ltr" style="text-align:left;"><code><%= row.password %></code></td>
              <td><button type="button" class="btn btn-secondary btn-sm copyRowBtn" data-password="<%= row.password %>" title="نسخ كلمة المرور لهذا الطالب">نسخ كلمة المرور</button></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    (function () {
      var btn = document.getElementById("copyAllBtn");
      if (!btn) return;
      var lines = ["أكاديمية آل الزين للعلوم القانونية والعدلية — حسابات الدفعة"];
      <% results.forEach(function (row) { %>
        lines.push("<%= row.name %> — الرمز: <%= row.platformId %> — كلمة المرور: <%= row.password %>");
      <% }); %>
      lines.push("عند أول دخول: تغيير كلمة المرور وإدخال البريد إلزامي.");
      var text = lines.join("\n");
      btn.addEventListener("click", function () {
        var done = function () {
          btn.textContent = "نُسخت كل البطاقات";
          window.setTimeout(function () { btn.textContent = "نسخ كل البطاقات"; }, 1800);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done).catch(done);
        } else {
          var ta = document.createElement("textarea");
          ta.value = text;
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand("copy"); } catch (err) { /* تجاهل */ }
          document.body.removeChild(ta);
          done();
        }
      });
    })();

    document.addEventListener("click", function (event) {
      var btn = event.target.closest(".copyRowBtn");
      if (!btn) return;
      var value = btn.getAttribute("data-password") || "";
      var done = function () {
        btn.textContent = "نُسخت";
        window.setTimeout(function () { btn.textContent = "نسخ كلمة المرور"; }, 1500);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(value).then(done).catch(done);
      } else {
        var ta = document.createElement("textarea");
        ta.value = value;
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand("copy"); } catch (err) { /* تجاهل */ }
        document.body.removeChild(ta);
        done();
      }
    });
  </script>
<% } %>

<% if (failures && failures.length) { %>
  <div class="table-card" style="margin-bottom:18px;">
    <div class="table-card-head"><h3>سطور لم تُنشأ (<%= failures.length %>)</h3></div>
    <div class="side-card-body" style="padding:16px 20px;">
      <ul class="failures-list">
        <% failures.forEach(function (f) { %>
          <li><strong>سطر <%= f.line %>:</strong> <span dir="auto"><%= f.text %></span> — <span style="color:var(--danger, #c0392b);"><%= f.reason %></span></li>
        <% }); %>
      </ul>
    </div>
  </div>
<% } %>

<style>
.failures-list { list-style: none; display: grid; gap: 8px; color: var(--text-secondary); font-size: 0.9rem; }
.failures-list li { padding: 8px 12px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg-subtle); }
@media print {
  body * { visibility: hidden; }
  .import-results, .import-results * { visibility: visible; }
  .import-results { position: fixed; inset: 5%; border: 2px solid #000; }
  .import-results .btn { display: none; }
}
</style>
