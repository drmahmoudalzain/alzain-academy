<section class="page-header">
  <div class="page-header-info">
    <h2>التقرير الشامل</h2>
    <p>تقرير المقررات والدرجات لكل قسم أكاديمي — تُطبع أو تُحفظ PDF من المتصفح.</p>
  </div>
  <div class="page-header-actions">
    <a class="btn btn-secondary" href="/owner/report/csv">تحميل CSV</a>
    <button class="btn btn-primary" onclick="window.print()">طباعة / حفظ PDF</button>
  </div>
</section>

<div class="alert-inline info" role="note" style="margin-bottom:20px;">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
  <div>يصدر هذا التقرير بحسب الأقسام الأكاديمية: البكالوريوس المشترك، ومسارا الطلاب والطالبات (منفصلة)، والأقسام المختلطة (المعادلة، طلاب من الخارج، الدراسات العليا).</div>
</div>

<% for (const section of sections) { %>
  <section class="table-card" style="margin-bottom:24px;">
    <div class="table-card-head">
      <h3><%= section.title %></h3>
      <span class="chip"><%= section.rows.length %> طلاب</span>
    </div>
    <div style="overflow-x:auto;">
      <table class="data-table">
        <thead>
          <tr><th>#</th><th>الاسم</th><th>الرقم الجامعي</th><th>المستوى</th><th>المقررات</th><th>متوسط الدرجات</th><th>نسبة الحضور</th><th>النقاط</th></tr>
        </thead>
        <tbody>
          <% for (const student of section.rows) { %>
            <tr>
              <td><%= student.id %></td>
              <td><strong><%= student.name %></strong></td>
              <td dir="ltr" style="text-align:left;"><code><%= student.code %></code></td>
              <td><%= student.level %></td>
              <td><%= student.courses %></td>
              <td><%= student.average %>%</td>
              <td><%= student.attendanceRate %>%</td>
              <td><%= student.points %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>
<% } %>

<style>
@media print {
  .sidebar, .topbar, .sidebar-overlay, .page-header-actions, .app-footer { display: none !important; }
  .app { display: block; }
  .main { margin: 0 !important; }
  body { background: #fff !important; }
  .content { padding: 0 !important; }
  .table-card { box-shadow: none; border: 1px solid #ddd; margin-bottom: 24px; page-break-inside: avoid; }
  .table-card-head h3 { font-size: 1.05rem; }
}
</style>
