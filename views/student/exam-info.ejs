<section class="page-header">
  <div class="page-header-info">
    <h2><%= exam.title %></h2>
    <p><%= exam.courses ? `${exam.courses.code} — ${exam.courses.title}` : '' %></p>
  </div>
</section>

<% if (flash) { %>
  <div class="alert-inline <%= flash.tone %>" role="alert">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
    <div><%= flash.text %></div>
  </div>
<% } %>

<div class="table-card">
  <div class="table-card-head">
    <h3>تفاصيل الاختبار</h3>
    <span class="chip"><%= status === 'open' ? 'مفتوح الآن' : (status === 'upcoming' ? 'لم يبدأ بعد' : 'مغلق') %></span>
  </div>
  <div class="table-scroll">
    <table class="data-table">
      <tbody>
        <tr><th scope="row">المقرر</th><td><strong><%= exam.courses ? `${exam.courses.code} — ${exam.courses.title}` : '—' %></strong></td></tr>
        <tr><th scope="row">عدد الأسئلة</th><td><%= questionCount %> أسئلة</td></tr>
        <tr><th scope="row">الدرجة الكلية</th><td><%= totalPoints %> نقطة</td></tr>
        <tr><th scope="row">مدة الاختبار</th><td><%= exam.duration_min || 60 %> دقيقة</td></tr>
        <tr><th scope="row">يبدأ</th><td><%= exam.starts_at ? format.formatDateTime(exam.starts_at) : 'غير محدد' %></td></tr>
        <tr><th scope="row">ينتهي</th><td><%= exam.ends_at ? format.formatDateTime(exam.ends_at) : 'غير محدد' %></td></tr>
      </tbody>
    </table>
  </div>
</div>

<div class="stack" style="margin-top:18px;">
  <div class="alert-inline info" role="note">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
    <div>يُسلَّم الاختبار تلقائياً عند انتهاء الوقت، ولا يمكن التراجع بعد التسليم. تأكد من استقرار اتصالك قبل البدء.</div>
  </div>

  <% if (status === 'open') { %>
    <form method="post" action="/student/exams/<%= exam.id %>/start">
      <button type="submit" class="btn btn-primary btn-block">ابدأ الاختبار الآن</button>
    </form>
  <% } else if (status === 'upcoming') { %>
    <button class="btn btn-block" disabled>لم يبدأ الاختبار بعد</button>
  <% } else { %>
    <button class="btn btn-block" disabled>انتهى موعد الاختبار</button>
  <% } %>

  <a class="btn btn-secondary btn-block" href="/student/exams">العودة إلى الاختبارات</a>
</div>
