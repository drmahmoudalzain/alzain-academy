<%
  const activeTrack = typeof track !== 'undefined' ? track : 'all';
  const counts = typeof trackCounts !== 'undefined' ? trackCounts : {};
  const trackTabHref = typeof tabHref !== 'undefined' ? tabHref : (value) => `?track=${value}`;
  const levelTabHref = typeof levelHref !== 'undefined' ? levelHref : (value) => `?track=${activeTrack}&level=${value}`;
  const searchText = typeof searchValue !== 'undefined' ? String(searchValue ?? '').trim() : '';
  const activeLevel = typeof level !== 'undefined' ? level : 'all';
  const countsByLevel = typeof levelCounts !== 'undefined' ? levelCounts : {};
  const genderCounts = typeof bachelorGenderCounts !== 'undefined' ? bachelorGenderCounts : counts;
  const countOf = (key) => Number(counts[key] ?? 0);
  const levelCountOf = (key) => Number(countsByLevel[key] ?? 0);
  const genderCountOf = (key) => Number(genderCounts[key] ?? 0);
  const bachelorSelected = ['bachelor', 'bachelor_m', 'bachelor_f'].includes(activeTrack);
  const narrowed = activeTrack !== 'all' || activeLevel !== 'all' || Boolean(searchText);
  const levelOptions = [
    { value: 'all', label: 'كل المستويات' },
    { value: 1, label: 'الأول' },
    { value: 2, label: 'الثاني' },
    { value: 3, label: 'الثالث' },
    { value: 4, label: 'الرابع' },
  ];
%>

<section class="page-header">
  <div class="page-header-info">
    <h2>الطلاب</h2>
    <p>
      الطلاب المسموح لك بعرض بياناتهم — <%= typeof totalVisible !== 'undefined' ? totalVisible : students.length %> طالب.
      <% if (narrowed) { %>المعروض الآن: <%= students.length %>.<% } %>
    </p>
  </div>
  <% if (students.length) { %>
    <div class="page-header-actions export-actions">
      <span class="muted">تصدير المحدد</span>
      <button class="btn btn-primary" type="submit" form="studentExportForm" name="format" value="xlsx">Excel</button>
      <button class="btn btn-secondary" type="submit" form="studentExportForm" name="format" value="word">Word</button>
      <button class="btn btn-secondary" type="submit" form="studentExportForm" name="format" value="pdf">PDF</button>
      <button class="btn btn-secondary" type="submit" form="studentExportForm" name="format" value="csv">CSV</button>
    </div>
  <% } %>
</section>

<nav class="student-filters" aria-label="تصفية الطلاب">
  <div class="student-filter-row">
    <a class="filter-tab <%= activeTrack === 'all' ? 'active' : '' %>" href="<%= trackTabHref('all') %>" <%= activeTrack === 'all' ? 'aria-current="page"' : '' %>>
      الكل <span class="tab-count"><%= countOf('all') %></span>
    </a>
    <a class="filter-tab <%= bachelorSelected ? 'active' : '' %>" href="<%= trackTabHref('bachelor') %>" <%= bachelorSelected ? 'aria-current="page"' : '' %>>
      بكالوريوس <span class="tab-count"><%= countOf('bachelor') %></span>
    </a>
    <a class="filter-tab <%= activeTrack === 'equiv' ? 'active' : '' %>" href="<%= trackTabHref('equiv') %>" <%= activeTrack === 'equiv' ? 'aria-current="page"' : '' %>>
      المعادلة <span class="tab-count"><%= countOf('equiv') %></span>
    </a>
    <a class="filter-tab <%= activeTrack === 'external' ? 'active' : '' %>" href="<%= trackTabHref('external') %>" <%= activeTrack === 'external' ? 'aria-current="page"' : '' %>>
      من الخارج <span class="tab-count"><%= countOf('external') %></span>
    </a>
    <a class="filter-tab <%= activeTrack === 'grad' ? 'active' : '' %>" href="<%= trackTabHref('grad') %>" <%= activeTrack === 'grad' ? 'aria-current="page"' : '' %>>
      الدراسات العليا <span class="tab-count"><%= countOf('grad') %></span>
    </a>
  </div>

  <% if (bachelorSelected) { %>
    <div class="student-filter-row student-filter-subrow student-filter-levels">
      <span class="student-filter-label">المستوى</span>
      <% for (const option of levelOptions) { %>
        <% const levelCount = levelCountOf(option.value); %>
        <% const levelActive = String(activeLevel) === String(option.value); %>
        <% if (levelCount === 0 && !levelActive) { %>
          <span class="filter-tab filter-tab-level is-empty" aria-disabled="true">
            <%= option.label %> <span class="tab-count">0</span>
          </span>
        <% } else { %>
          <a class="filter-tab filter-tab-level <%= levelActive ? 'active' : '' %>" href="<%= levelTabHref(option.value) %>" <%= levelActive ? 'aria-current="page"' : '' %>>
            <%= option.label %> <span class="tab-count"><%= levelCount %></span>
          </a>
        <% } %>
      <% } %>
    </div>

    <div class="student-filter-row student-filter-subrow student-filter-genders">
      <span class="student-filter-label">الجنس</span>
      <a class="filter-tab filter-tab-sub <%= activeTrack === 'bachelor' ? 'active' : '' %>" href="<%= trackTabHref('bachelor') %>" <%= activeTrack === 'bachelor' ? 'aria-current="page"' : '' %>>
        كل البكالوريوس <span class="tab-count"><%= genderCountOf('bachelor') %></span>
      </a>
      <a class="filter-tab filter-tab-sub <%= activeTrack === 'bachelor_m' ? 'active' : '' %>" href="<%= trackTabHref('bachelor_m') %>" <%= activeTrack === 'bachelor_m' ? 'aria-current="page"' : '' %>>
        طلاب <span class="tab-count"><%= genderCountOf('bachelor_m') %></span>
      </a>
      <a class="filter-tab filter-tab-sub <%= activeTrack === 'bachelor_f' ? 'active' : '' %>" href="<%= trackTabHref('bachelor_f') %>" <%= activeTrack === 'bachelor_f' ? 'aria-current="page"' : '' %>>
        طالبات <span class="tab-count"><%= genderCountOf('bachelor_f') %></span>
      </a>
    </div>
  <% } %>
</nav>

<% if (students.length) { %>
  <form id="studentExportForm" method="post" action="<%= basePath %>/export">
    <div class="table-card">
      <div class="table-scroll">
        <table class="data-table">
          <thead><tr><th><input type="checkbox" id="checkAll" aria-label="تحديد كل الطلاب المعروضين"></th><th>#</th><th>الاسم</th><th>الرقم الأكاديمي</th><th>المسار</th><th>المقررات</th><th>الحالة</th><th></th></tr></thead>
          <tbody>
            <% for (const student of students) { %>
              <tr>
                <td><input type="checkbox" name="ids" value="<%= student.id %>" class="student-check" aria-label="تحديد <%= student.name %>"></td>
                <td><%= student.id %></td>
                <td><strong><a href="<%= basePath %>/<%= student.id %>" style="color:inherit;text-decoration:none;"><%= student.name %></a></strong></td>
                <td dir="ltr" style="text-align:left;"><code><%= student.platform_id ?? student.university_id ?? '—' %></code></td>
                <td><%= getProfile(student.track).label %><%= student.level ? ' · م' + student.level : '' %></td>
                <td><%= student.courseCount %></td>
                <td><span class="chip" style="<%= student.is_active ? 'color:var(--success);border-color:var(--success-border);' : 'color:var(--danger);border-color:var(--danger-border);' %>"><%= student.is_active ? 'نشط' : 'موقوف' %></span></td>
                <td><a class="chip" href="<%= basePath %>/<%= student.id %>">عرض</a></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </form>
  <p class="muted" style="margin-top:8px;font-size:0.78rem;">حدّد طالباً أو أكثر ثم اختر الصيغة من أعلى الصفحة. التحديد يشمل كل المسارات الظاهرة حالياً.</p>
  <script>
    (function () {
      var all = document.getElementById('checkAll');
      if (!all) return;
      var checks = Array.prototype.slice.call(document.querySelectorAll('.student-check'));
      all.addEventListener('change', function () {
        checks.forEach(function (box) { box.checked = all.checked; });
      });
      checks.forEach(function (box) {
        box.addEventListener('change', function () {
          all.checked = checks.length > 0 && checks.every(function (item) { return item.checked; });
        });
      });
    })();
  </script>
<% } else { %>
  <div class="empty-state student-empty">
    <h3><%= narrowed ? 'لا توجد نتائج مطابقة' : 'لا يوجد طلاب' %></h3>
    <p>
      <% if (narrowed) { %>
        لا يوجد طلاب ضمن الفئة المختارة أو البحث الحالي. يمكنك تغيير التبويب أو مسح البحث.
      <% } else { %>
        لا يوجد طلاب ضمن نطاق صلاحياتك حالياً.
      <% } %>
    </p>
    <% if (narrowed) { %><a class="btn btn-secondary" href="<%= basePath %>">عرض كل الطلاب</a><% } %>
  </div>
<% } %>
