<section class="page-header">
  <div class="page-header-info">
    <h2>إضافة اختبار</h2>
    <p>بيانات الاختبار ثم أضف الأسئلة — نوع السؤال يحدد شكل الخيارات.</p>
  </div>
</section>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert-inline error" role="alert">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
    <div><%= error %></div>
  </div>
<% } %>

<% if (typeof ai !== 'undefined' && ai) { %>
  <div class="table-card" style="margin-bottom:20px;">
    <div class="table-card-head"><h3>المساعد الذكي — توليد الأسئلة</h3></div>
    <div class="side-card-body" style="padding:16px 18px;">
      <div class="form-grid" style="grid-template-columns: 1.6fr 1fr auto; align-items:end;">
        <label>موضوع الأسئلة
          <input id="aiTopic" type="text" maxlength="200" placeholder="مثال: مصادر القانون في التشريع والعرف والإجتهاد">
        </label>
        <label>عدد الأسئلة
          <select id="aiCount">
            <option value="3">3 أسئلة</option>
            <option value="5" selected>5 أسئلة</option>
            <option value="8">8 أسئلة</option>
            <option value="10">10 أسئلة</option>
          </select>
        </label>
        <button type="button" class="btn btn-secondary" id="aiGenerateBtn" <%= ai.ready ? '' : 'disabled' %>>ولّد بالذكاء الاصطناعي</button>
      </div>
      <p id="aiNote" class="form-hint" style="margin-top:10px;">
        <% if (ai.ready) { %>بعد التوليد يمكنك مراجعة كل سؤال وتعديله قبل حفظ الاختبار — النقاط تُحتسب تلقائياً من الأسئلة.<% } else { %>المساعد الذكي غير مُفعّل — يمكن للمالك تفعيله من الإعدادات بإدخال مفتاح Gemini.<% } %>
      </p>
    </div>
  </div>
<% } %>

<form method="post" action="<%= basePath %>/exams" id="examForm" class="table-card">
  <div class="table-card-head"><h3>بيانات الاختبار</h3></div>
  <div class="side-card-body" style="padding:24px;">
    <div class="form-grid">
      <label>المقرر *
        <select name="course_id" required>
          <% for (const course of courses) { %>
            <option value="<%= course.id %>" <%= selectedCourse === course.id ? 'selected' : '' %>><%= course.code %> — <%= course.title %></option>
          <% } %>
        </select>
      </label>
      <label>عنوان الاختبار *
        <input type="text" name="title" required maxlength="180" placeholder="مثال: اختبار منتصف الفصل">
      </label>
      <label>الوصف
        <textarea name="description" rows="2" maxlength="1000"></textarea>
      </label>
      <div class="form-grid" style="grid-template-columns: 1fr 1fr 1fr;">
        <label>يبدأ
          <input type="datetime-local" name="starts_at">
        </label>
        <label>ينتهي
          <input type="datetime-local" name="ends_at">
        </label>
        <label>المدة (دقيقة)
          <input type="number" name="duration_min" value="60" min="5" max="600">
        </label>
      </div>
      <label class="checkbox-row" style="display:flex;align-items:center;gap:10px;">
        <input type="checkbox" name="is_published" checked>
        <span>نشر فوراً — سيتمكن الطلاب من أداء الاختبار فور موعد بدايته</span>
      </label>
    </div>
  </div>

  <div class="table-card-head" style="border-top:1px solid var(--border);">
    <h3>الأسئلة</h3>
    <button type="button" class="btn btn-secondary btn-sm" id="addQuestionBtn">+ إضافة سؤال</button>
  </div>
  <div class="side-card-body" style="padding:16px 18px;">
    <div id="questionBuilder" style="display:grid;gap:12px;"></div>
    <p class="form-hint muted" style="margin-top:10px;">اتركه فارغاً وأدرج الأسئلة لاحقاً — أو أضف الآن؛ الخيار الصحيح يرقّم من 0 مطابق لتسلسل الخيارات المكتوبة.</p>
    <input type="hidden" name="questions" id="questionsJson" value="[]">

    <div style="display:flex;gap:10px;margin-top:14px;">
      <button type="submit" class="btn btn-primary">حفظ الاختبار والامتحان</button>
      <a class="btn btn-secondary" href="<%= basePath %>/exams">إلغاء</a>
    </div>
  </div>
</form>

<script>
(function () {
  "use strict";
  const container = document.getElementById("questionBuilder");
  const jsonField = document.getElementById("questionsJson");
  const addBtn = document.getElementById("addQuestionBtn");
  let counter = 0;

  function optionRow(index) {
    const div = document.createElement("div");
    div.className = "qb-row form-grid";
    div.style.cssText = "border:1px solid var(--border);border-radius:12px;padding:14px;background:var(--bg-subtle);";
    div.dataset.index = String(index);
    div.innerHTML = `
      <div class="form-grid" style="grid-template-columns: 1fr 1fr 90px 38px;">
        <label>النوع
          <select class="qb-type">
            <option value="mcq">اختيار واحد</option>
            <option value="multi">اختيار متعدد</option>
            <option value="truefalse">صح/خطأ</option>
            <option value="essay">سؤال مقالي</option>
          </select>
        </label>
        <label>الدرجة
          <input class="qb-points" type="number" value="2" min="1" max="100">
        </label>
        <label>الترتيب
          <input class="qb-position" type="number" value="${index + 1}" readonly>
        </label>
        <button type="button" class="qb-remove" aria-label="حذف السؤال" style="height:38px;align-self:end;border:1px solid var(--border);background:var(--bg-surface);border-radius:8px;cursor:pointer;color:var(--danger);font-weight:700;">×</button>
      </div>
      <label>نص السؤال *
        <textarea class="qb-text" rows="2" required placeholder="اكتب السؤال..."></textarea>
      </label>
      <div class="qb-options-wrap">
        <label>الخيارات — سطر لكل خيار (يتم تجاهلها في سؤالي صح/خطأ والمقالي)
          <textarea class="qb-options" rows="4" placeholder="الخيار أ&#10;الخيار ب&#10;الخيار ج&#10;الخيار د"></textarea>
        </label>
        <div class="form-grid" style="grid-template-columns: 1fr 1fr;">
          <label>الخيار الصحيح (رقم)
            <span class="form-hint">0 = الخيار الأول — لأسئلة الاختيار الواحد/صح-خطأ</span>
            <input class="qb-correct" type="text" dir="ltr" style="text-align:left;" placeholder="0">
          </label>
          <label>للاختيار المتعدد (أرقام مفصولة بفواصل)
            <span class="form-hint">مثال: 0,2</span>
            <input class="qb-correct-indices" type="text" dir="ltr" style="text-align:left;" placeholder="0,2">
          </label>
        </div>
      </div>
    `;
    return div;
  }

  function syncJson() {
    const rows = [...container.querySelectorAll(".qb-row")];
    const data = rows.map((row) => {
      const type = row.querySelector(".qb-type").value;
      const text = row.querySelector(".qb-text").value.trim();
      const points = Number(row.querySelector(".qb-points").value || 1);
      const options = row.querySelector(".qb-options").value
        .split("\n").map(s => s.trim()).filter(Boolean);
      const correct = row.querySelector(".qb-correct").value.trim();
      const correctIndices = row.querySelector(".qb-correct-indices").value
        .split(",").map(s => Number(s.trim())).filter(n => Number.isInteger(n));
      if (!text) return null;
      return {
        type,
        text,
        points,
        options: type === "essay" ? [] : options,
        correct_index: type === "multi" ? null : (correct === "" ? null : Number(correct)),
        correct_indices: type === "multi" ? correctIndices : null,
      };
    }).filter(Boolean);
    jsonField.value = JSON.stringify(data);
  }

  function addQuestion() {
    const div = optionRow(counter++);
    div.querySelector(".qb-remove").addEventListener("click", () => {
      div.remove();
      syncJson();
    });
    div.querySelectorAll("input, textarea, select").forEach((el) => {
      el.addEventListener("input", syncJson);
      el.addEventListener("change", syncJson);
    });
    container.appendChild(div);
    syncJson();
    return div;
  }

  function aiFill(question) {
    const div = addQuestion();
    div.querySelector(".qb-type").value = question.type || "mcq";
    div.querySelector(".qb-points").value = question.points || 2;
    div.querySelector(".qb-text").value = question.text || "";
    div.querySelector(".qb-options").value = Array.isArray(question.options) ? question.options.join("\n") : "";
    if (question.type === "multi") {
      div.querySelector(".qb-correct-indices").value = Array.isArray(question.correct_indices) ? question.correct_indices.join(",") : "";
      div.querySelector(".qb-correct").value = "";
    } else {
      div.querySelector(".qb-correct").value = question.correct_index != null ? String(question.correct_index) : "";
      div.querySelector(".qb-correct-indices").value = "";
    }
    syncJson();
  }

  addBtn?.addEventListener("click", addQuestion);
  addQuestion();

  // ---------- المساعد الذكي: توليد الأسئلة ----------
  const aiBtn = document.getElementById("aiGenerateBtn");
  const aiTopic = document.getElementById("aiTopic");
  const aiCount = document.getElementById("aiCount");
  const aiNote = document.getElementById("aiNote");
  const courseSelect = document.querySelector("select[name='course_id']");

  if (aiBtn && !aiBtn.disabled) {
    aiBtn.addEventListener("click", async () => {
      const topic = (aiTopic && aiTopic.value.trim()) || (courseSelect ? courseSelect.selectedOptions[0]?.textContent?.split("—")[0].trim() : "") || "القانون الدستوري";
      aiBtn.disabled = true;
      if (aiNote) aiNote.textContent = "جارٍ توليد الأسئلة...";
      try {
        const body = new URLSearchParams({
          course_id: courseSelect ? courseSelect.value : "",
          topic,
          count: aiCount ? aiCount.value : "5",
        }).toString();
        const res = await fetch("<%= basePath %>/ai/generate-exam-questions", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded", "Accept": "application/json" },
          body,
        });
        const data = await res.json();
        if (!data.ok) {
          if (aiNote) aiNote.textContent = data.error || "تعذر التوليد. حاول لاحقاً.";
          return;
        }
        container.innerHTML = "";
        counter = 0;
        (data.questions || []).forEach((question) => aiFill(question));
        if (aiNote) aiNote.textContent = `تم توليد ${data.questions.length} سؤال — راجعها واحفظ الاختبار.`;
      } catch {
        if (aiNote) aiNote.textContent = "تعذر الاتصال بالمساعد الذكي — تحقق من الشبكة.";
      } finally {
        aiBtn.disabled = false;
      }
    });
  }

  const form = document.getElementById("examForm");
  form?.addEventListener("submit", () => { syncJson(); });
})();
</script>
