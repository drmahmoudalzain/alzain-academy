<section class="page-header">
  <div class="page-header-info">
    <h2><%= student.name %></h2>
    <p><code><%= student.university_id ?? '—' %></code> · <%= student.track === 'equiv' ? 'قسم المعادلة' : 'مسار البكالوريوس' %><%= student.level ? ' · المستوى ' + student.level : '' %></p>
  </div>
  <div class="page-header-actions">
    <a class="btn btn-secondary" href="<%= basePath %>/<%= student.id %>/edit">تعديل البيانات</a>
    <% if (canResetPassword) { %>
      <form method="post" action="<%= basePath %>/<%= student.id %>/reset-password" style="display:inline;">
        <button class="btn btn-secondary" type="submit">إعادة تعيين كلمة المرور</button>
      </form>
    <% } %>
  </div>
</section>

<div class="grid-2" style="margin-bottom:20px;">
  <div class="table-card">
    <div class="table-card-head"><h3>البيانات الشخصية</h3></div>
    <div class="table-scroll">
      <table class="data-table">
        <tbody>
          <tr><th scope="row">الرقم الجامعي</th><td dir="ltr" style="text-align:left;"><code><%= student.university_id ?? '—' %></code></td></tr>
          <tr><th scope="row">البريد</th><td dir="ltr" style="text-align:left;"><code><%= student.email ?? '—' %></code></td></tr>
          <tr><th scope="row">رقم الجوال</th><td dir="ltr" style="text-align:left;"><code><%= student.phone ?? '—' %></code></td></tr>
          <tr><th scope="row">الجنس</th><td><%= student.gender === 'M' ? 'ذكر' : (student.gender === 'F' ? 'أنثى' : '—') %></td></tr>
          <tr><th scope="row">مسجل منذ</th><td><%= format.formatDate(student.created_at) %></td></tr>
          <tr><th scope="row">آخر دخول</th><td><%= student.last_login ? format.formatDateTime(student.last_login) : 'لم يدخل بعد' %></td></tr>
          <tr><th scope="row">الحالة</th><td><span class="chip" style="<%= student.is_active ? 'color:var(--success);border-color:var(--success-border);' : 'color:var(--danger);border-color:var(--danger-border);' %>"><%= student.is_active ? 'نشط' : 'موقوف' %></span></td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="table-card">
    <div class="table-card-head"><h3>نقاطه (<%= format.formatNumber(points) %>)</h3></div>
    <div class="side-card-body" style="padding:20px 22px;">
      <div style="font-family:var(--font-head);font-size:3rem;color:var(--navy-dark);line-height:1;"><%= format.formatNumber(points) %></div>
      <p class="muted" style="margin:6px 0 0;">نقطة مكتسبة عبر الحضور والتفاعل وتسليم الواجبات.</p>
    </div>
  </div>
</div>

<div class="table-card">
  <div class="table-card-head"><h3>المقررات المسجل فيها (<%= courses.length %>)</h3></div>
  <div class="table-scroll">
    <table class="data-table">
      <thead><tr><th>المقرر</th><th>الحضور</th><th>الاختبارات</th><th>الواجبات</th><th>المجموع</th><th>التقدير</th></tr></thead>
      <tbody>
        <% for (const grade of courses) { %>
          <tr>
            <td><strong><%= grade.course.title %></strong><br><code><%= grade.course.code %></code></td>
            <td><%= grade.attendance.earned %> / <%= grade.attendance.weight %></td>
            <td><%= grade.exams.earned %> / <%= grade.exams.weight %></td>
            <td><%= grade.assignments.earned %> / <%= grade.assignments.weight %></td>
            <td><strong><%= grade.total %></strong></td>
            <td><span class="chip"><%= grade.letter %></span></td>
          </tr>
        <% } %>
        <% if (!courses.length) { %><tr><td colspan="6" class="muted text-center">لا يوجد تسجيل في مقررات.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
