<section class="page-header">
  <div class="page-header-info">
    <h2>سجل الدرجات — <%= course.title %></h2>
    <p><code><%= course.code %></code> · <% if (isBachelor) { %>الحضور <%= weights.attendance %> · التفاعل <%= weights.interaction %> · الاختبارات <%= weights.exams %> <% } else { %>الواجبات <%= weights.assignments %> <% } %>— المجموع من 300 نقطة</p>
  </div>
  <div class="page-header-actions">
    <a class="btn btn-secondary" href="<%= basePath %>/courses/<%= course.id %>">العودة للمقرر</a>
  </div>
</section>

<div class="table-card">
  <div class="table-card-head">
    <h3>الطلاب (<%= rows.length %>) — متوسط <%= average %>%</h3>
  </div>
  <div class="table-scroll">
    <table class="data-table">
      <thead>
        <% if (isBachelor) { %>
          <tr><th>#</th><th>الاسم</th><th>الرقم</th><th>الحضور</th><th>التفاعل</th><th>الاختبارات</th><th>المجموع</th><th>التقدير</th></tr>
        <% } else { %>
          <tr><th>#</th><th>الاسم</th><th>الرقم</th><th>الواجبات</th><th>المجموع</th><th>التقدير</th></tr>
        <% } %>
      </thead>
      <tbody>
        <% for (const [index, row] of rows.entries()) { const g = row.grade; %>
          <tr>
            <td><%= index + 1 %></td>
            <td><strong><%= row.student.name %></strong></td>
            <td dir="ltr" style="text-align:left;"><code><%= row.student.platform_id ?? row.student.university_id ?? '—' %></code></td>
            <% if (isBachelor) { %>
              <td><%= g.attendance.earned %> / <%= g.attendance.weight %></td>
              <td><%= g.interaction.earned %> / <%= g.interaction.weight %></td>
              <td><%= g.exams.earned %> / <%= g.exams.weight %></td>
            <% } else { %>
              <td><%= g.assignments.earned %> / <%= g.assignments.weight %></td>
            <% } %>
            <td><strong><%= g.total %> / 300</strong></td>
            <td><span class="chip"><%= g.letter %></span></td>
          </tr>
        <% } %>
        <% if (!rows.length) { %><tr><td colspan="<%= isBachelor ? 8 : 6 %>" class="muted text-center">لا توجد تسجيلات بعد — سجّل الطلاب في المقرر لعرض الدرجات.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
