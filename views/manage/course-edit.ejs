<section class="page-header">
  <div class="page-header-info">
    <h2>تعديل المقرر</h2>
    <p><code><%= course.code %></code> — التعديل فوري.</p>
  </div>
</section>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert-inline error" role="alert">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
    <div><%= error %></div>
  </div>
<% } %>

<form method="post" action="<%= basePath %>/courses/<%= course.id %>/edit" class="table-card">
  <div class="table-scroll">
    <div class="side-card-body" style="padding:24px;">
      <div class="form-grid">
        <div class="form-grid" style="grid-template-columns: 2fr 1fr;">
          <label>اسم المقرر *
            <input type="text" name="title" value="<%= course.title %>" required maxlength="160">
          </label>
          <label>الرمز *
            <input type="text" name="code" value="<%= course.code %>" required maxlength="12" dir="ltr" style="text-align:left;text-transform:uppercase;">
          </label>
        </div>

        <label>الوصف
          <textarea name="description" rows="3" maxlength="2000"><%= course.description || '' %></textarea>
        </label>

        <% if (isOwner && teachers.length) { %>
          <label>الأستاذ المسؤول
            <select name="teacher_id">
              <% for (const teacher of teachers) { %><option value="<%= teacher.id %>" <%= teacher.id === course.teacher_id ? 'selected' : '' %>><%= teacher.name %></option><% } %>
            </select>
          </label>
        <% } %>

        <% if (isOwner) { %>
          <label>المقرر الأصل
            <select name="parent_course_id">
              <option value="">مقرر أصلي</option>
              <% for (const parent of parents ?? []) { %>
                <option value="<%= parent.id %>" <%= Number(parentId) === parent.id ? 'selected' : '' %>><%= parent.code %> — <%= parent.title %></option>
              <% } %>
            </select>
          </label>
        <% } %>

        <div class="form-grid" style="grid-template-columns: repeat(3, 1fr);">
          <label>المسار
            <select name="track">
              <%- include('../partials/track-options', { currentTrack: course.track }) %>
            </select>
          </label>
          <label>المستوى
            <select name="level">
              <% for (let i = 1; i <= 4; i += 1) { %><option value="<%= i %>" <%= Number(course.level) === i ? 'selected' : '' %>>المستوى <%= i %></option><% } %>
            </select>
          </label>
          <label>اللون
            <input type="color" name="color" value="<%= course.color || '#123A63' %>" style="height:42px;">
          </label>
        </div>

      </div>

      <div class="form-hint muted" style="margin-top:14px;line-height:1.9;">
        نظام التقييم مثبت ولا يحتاج أوزاناً: مقررات البكالوريوس 300 نقطة (أول 10 محاضرات: 10 حضور + 10 تفاعل + 10 اختبار لكل محاضرة مباشرة/إلكترونية، و30 نقطة اختبار للمسجلة)، وبقية المسارات 300 نقطة للواجبات فقط.
      </div>

      <div style="display:flex;gap:10px;margin-top:18px;">
        <button type="submit" class="btn btn-primary">حفظ التعديلات</button>
        <a class="btn btn-secondary" href="<%= basePath %>/courses/<%= course.id %>">إلغاء</a>
      </div>
    </div>
  </div>
</form>
