<section class="page-header">
  <div class="page-header-info">
    <h2>تعديل المحاضرة</h2>
    <p><code><%= lecture.course ? lecture.course.code : '' %></code></p>
  </div>
</section>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert-inline error" role="alert">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
    <div><%= error %></div>
  </div>
<% } %>

<form method="post" action="<%= basePath %>/lectures/<%= lecture.id %>/edit" class="table-card">
  <div class="table-scroll">
    <div class="side-card-body" style="padding:24px;">
      <div class="form-grid">
        <label>المقرر *
          <select name="course_id" required>
            <% for (const course of courses) { %>
              <option value="<%= course.id %>" <%= Number(selectedCourse) === course.id ? 'selected' : '' %>><%= course.code %> — <%= course.title %></option>
            <% } %>
          </select>
        </label>

        <label>عنوان المحاضرة *
          <input type="text" name="title" value="<%= lecture.title %>" required maxlength="180">
        </label>

        <label>الوصف
          <textarea name="description" rows="3" maxlength="2000"><%= lecture.description || '' %></textarea>
        </label>

        <div class="form-grid" style="grid-template-columns: 1.4fr 1fr 1fr;">
          <label>الموعد
            <input type="datetime-local" name="scheduled_at" value="<%= lecture.scheduled_at ? new Date(lecture.scheduled_at).toISOString().slice(0, 16) : '' %>">
          </label>
          <label>المدة (دقيقة)
            <input type="number" name="duration_min" value="<%= lecture.duration_min || 120 %>" min="15" max="600">
          </label>
          <label>نوع المحاضرة
            <select name="lecture_type">
              <option value="direct" <%= lecture.lecture_type === 'direct' ? 'selected' : '' %>>مباشر</option>
              <option value="online" <%= lecture.lecture_type === 'online' ? 'selected' : '' %>>أونلاين</option>
              <option value="recorded" <%= lecture.lecture_type === 'recorded' ? 'selected' : '' %>>مسجل</option>
            </select>
          </label>
        </div>

        <div class="fieldset-block">
          <div class="fieldset-title">نوع وسائط البث</div>
          <div class="choice-buttons" role="radiogroup" aria-label="نوع وسائط البث">
            <label class="choice-btn<%= !lecture.broadcast_mode || lecture.broadcast_mode === 'internal' ? ' selected' : '' %>">
              <input type="radio" name="broadcast_mode" value="internal" <%= !lecture.broadcast_mode || lecture.broadcast_mode === 'internal' ? 'checked' : '' %> hidden>
              <strong>داخل النظام</strong>
              <span>المنصة العامة</span>
            </label>
            <label class="choice-btn<%= lecture.broadcast_mode === 'youtube' ? ' selected' : '' %>">
              <input type="radio" name="broadcast_mode" value="youtube" <%= lecture.broadcast_mode === 'youtube' ? 'checked' : '' %> hidden>
              <strong>يوتيوب</strong>
              <span>تضمين رابط البث</span>
            </label>
            <label class="choice-btn<%= lecture.broadcast_mode === 'meet' ? ' selected' : '' %>">
              <input type="radio" name="broadcast_mode" value="meet" <%= lecture.broadcast_mode === 'meet' ? 'checked' : '' %> hidden>
              <strong>غوغل ميت</strong>
              <span>رابط اجتماع خارجي</span>
            </label>
          </div>

          <div class="choice-buttons" role="radiogroup" aria-label="وسائط المحاضرة" style="margin-top:12px;">
            <label class="choice-btn<%= !lecture.broadcast_media || lecture.broadcast_media === 'both' ? ' selected' : '' %>">
              <input type="radio" name="broadcast_media" value="both" <%= !lecture.broadcast_media || lecture.broadcast_media === 'both' ? 'checked' : '' %> hidden>
              <strong>صوت وفيديو</strong>
            </label>
            <label class="choice-btn<%= lecture.broadcast_media === 'audio' ? ' selected' : '' %>">
              <input type="radio" name="broadcast_media" value="audio" <%= lecture.broadcast_media === 'audio' ? 'checked' : '' %> hidden>
              <strong>صوت فقط</strong>
            </label>
            <label class="choice-btn<%= lecture.broadcast_media === 'video' ? ' selected' : '' %>">
              <input type="radio" name="broadcast_media" value="video" <%= lecture.broadcast_media === 'video' ? 'checked' : '' %> hidden>
              <strong>فيديو فقط</strong>
            </label>
          </div>
        </div>

        <div class="form-grid" style="grid-template-columns: 1fr 1fr;">
          <label>رابط يوتيوب
            <input type="url" name="youtube_url" value="<%= lecture.youtube_url || '' %>" dir="ltr" style="text-align:left;">
          </label>
          <label>رابط Google Meet
            <input type="url" name="live_url" value="<%= lecture.live_url || '' %>" dir="ltr" style="text-align:left;">
          </label>
        </div>
      </div>

      <div style="display:flex;gap:10px;margin-top:18px;">
        <button type="submit" class="btn btn-primary">حفظ التعديلات</button>
        <a class="btn btn-secondary" href="<%= basePath %>/lectures/<%= lecture.id %>">إلغاء</a>
      </div>
    </div>
  </div>
</form>
