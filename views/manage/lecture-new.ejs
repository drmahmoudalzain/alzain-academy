<section class="page-header">
  <div class="page-header-info">
    <h2>إضافة محاضرة</h2>
    <p>بيانات المحاضرة — تفعيل رمز الحضور يولّد رمزاً عشوائياً من 6 أرقام تلقائياً.</p>
  </div>
</section>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert-inline error" role="alert">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
    <div><%= error %></div>
  </div>
<% } %>

<form method="post" action="<%= basePath %>/lectures" class="table-card">
  <div class="table-scroll">
    <div class="side-card-body" style="padding:24px;">
      <div class="form-grid">
        <label>المقرر *
          <select name="course_id" required>
            <% for (const course of courses) { %>
              <option value="<%= course.id %>" <%= selectedCourse === course.id ? 'selected' : '' %>><%= course.code %> — <%= course.title %></option>
            <% } %>
          </select>
        </label>

        <label>عنوان المحاضرة *
          <input type="text" name="title" required maxlength="180" placeholder="مثال: مصادر القانون المباشرة والاحتياطية">
        </label>

        <label>الوصف
          <textarea name="description" rows="3" maxlength="2000" placeholder="محاور المحاضرة..."></textarea>
        </label>

        <div class="form-grid" style="grid-template-columns: 1.4fr 1fr 1fr;">
          <label>الموعد
            <input type="datetime-local" name="scheduled_at">
          </label>
          <label>المدة (دقيقة)
            <input type="number" name="duration_min" value="120" min="15" max="600">
          </label>
          <label>نوع المحاضرة
            <select name="lecture_type">
              <option value="direct">مباشر</option>
              <option value="online">أونلاين</option>
              <option value="recorded">مسجل</option>
            </select>
          </label>
        </div>

        <div class="fieldset-block">
          <div class="fieldset-title">نوع وسائط البث</div>
          <div class="choice-buttons" role="radiogroup" aria-label="نوع وسائط البث">
            <label class="choice-btn<%= (typeof broadcastMode === 'undefined' || !broadcastMode || broadcastMode === 'internal') ? ' selected' : '' %>">
              <input type="radio" name="broadcast_mode" value="internal" <%= (typeof broadcastMode === 'undefined' || !broadcastMode || broadcastMode === 'internal') ? 'checked' : '' %> hidden>
              <strong>داخل النظام</strong>
              <span>المنصة العامة</span>
            </label>
            <label class="choice-btn<%= typeof broadcastMode !== 'undefined' && broadcastMode === 'youtube' ? ' selected' : '' %>">
              <input type="radio" name="broadcast_mode" value="youtube" <%= typeof broadcastMode !== 'undefined' && broadcastMode === 'youtube' ? 'checked' : '' %> hidden>
              <strong>يوتيوب</strong>
              <span>تضمين رابط البث</span>
            </label>
            <label class="choice-btn<%= typeof broadcastMode !== 'undefined' && broadcastMode === 'meet' ? ' selected' : '' %>">
              <input type="radio" name="broadcast_mode" value="meet" <%= typeof broadcastMode !== 'undefined' && broadcastMode === 'meet' ? 'checked' : '' %> hidden>
              <strong>غوغل ميت</strong>
              <span>رابط اجتماع خارجي</span>
            </label>
          </div>

          <div class="choice-buttons" role="radiogroup" aria-label="وسائط المحاضرة" style="margin-top:12px;">
            <label class="choice-btn<%= (typeof broadcastMedia === 'undefined' || !broadcastMedia || broadcastMedia === 'both') ? ' selected' : '' %>">
              <input type="radio" name="broadcast_media" value="both" <%= (typeof broadcastMedia === 'undefined' || !broadcastMedia || broadcastMedia === 'both') ? 'checked' : '' %> hidden>
              <strong>صوت وفيديو</strong>
            </label>
            <label class="choice-btn<%= typeof broadcastMedia !== 'undefined' && broadcastMedia === 'audio' ? ' selected' : '' %>">
              <input type="radio" name="broadcast_media" value="audio" <%= typeof broadcastMedia !== 'undefined' && broadcastMedia === 'audio' ? 'checked' : '' %> hidden>
              <strong>صوت فقط</strong>
            </label>
            <label class="choice-btn<%= typeof broadcastMedia !== 'undefined' && broadcastMedia === 'video' ? ' selected' : '' %>">
              <input type="radio" name="broadcast_media" value="video" <%= typeof broadcastMedia !== 'undefined' && broadcastMedia === 'video' ? 'checked' : '' %> hidden>
              <strong>فيديو فقط</strong>
            </label>
          </div>
        </div>

        <div class="form-grid" style="grid-template-columns: 1fr 1fr;">
          <label>رابط يوتيوب (للمسجلة / لتضمين البث المباشر)
            <input type="url" name="youtube_url" dir="ltr" style="text-align:left;" placeholder="https://www.youtube.com/watch?v=...">
          </label>
          <label>رابط Google Meet (للأونلاين)
            <input type="url" name="live_url" dir="ltr" style="text-align:left;" placeholder="https://meet.google.com/...">
          </label>
        </div>

        <label class="checkbox-row" style="display:flex;align-items:center;gap:10px;">
          <input type="checkbox" name="attendance_open">
          <span>فتح تسجيل الحضور برمز — يُنشأ رمز عشوائي من 6 أرقام ويُعرض في صفحة المحاضرة للطلاب</span>
        </label>
      </div>

      <div style="display:flex;gap:10px;margin-top:18px;">
        <button type="submit" class="btn btn-primary">حفظ المحاضرة</button>
        <a class="btn btn-secondary" href="<%= basePath %>/lectures">إلغاء</a>
      </div>
    </div>
  </div>
</form>
