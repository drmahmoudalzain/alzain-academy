<section class="page-header">
  <div class="page-header-info">
    <h2><%= course.title %></h2>
    <p><code><%= course.code %></code> · <%= getProfile(course.track).label %> · <%= course.level ? 'المستوى ' + course.level : '' %></p>
  </div>
  <div class="page-header-actions">
    <% if (isOwner) { %>
      <a class="btn btn-primary" href="<%= basePath %>/courses/<%= course.id %>/enroll">تسجيل دفعة واحدة</a>
      <% if (!course.parent_course_id) { %>
        <form method="post" action="<%= basePath %>/courses/<%= course.id %>/branches" style="display:inline;" onsubmit="return confirm('إنشاء فرعي الطلاب والطالبات؟');">
          <button type="submit" class="btn btn-secondary">إنشاء الفروع</button>
        </form>
        <form method="post" action="<%= basePath %>/courses/<%= course.id %>/delete" style="display:inline;" onsubmit="return confirm('حذف المقرر نهائياً مع فروعه ومحتواه؟');">
          <button type="submit" class="btn btn-ghost" style="color:#a33;">حذف</button>
        </form>
      <% } %>
    <% } %>
    <a class="btn btn-secondary" href="<%= basePath %>/courses/<%= course.id %>/gradebook">سجل الدرجات</a>
    <% if (isOwner) { %>
      <a class="btn btn-secondary" href="<%= basePath %>/courses/<%= course.id %>/edit">تعديل</a>
      <form method="post" action="<%= basePath %>/courses/<%= course.id %>/archive" style="display:inline;">
        <button type="submit" class="btn btn-secondary"><%= course.archived ? 'إعادة تفعيل' : 'أرشفة المقرر' %></button>
      </form>
    <% } %>
  </div>
</section>

<% if (typeof notice !== 'undefined' && notice) { %>
  <div class="alert-inline success" role="status" style="margin-bottom:16px;">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
    <div><%= notice %></div>
  </div>
<% } %>

<% if (course.description) { %>
  <div class="table-card" style="margin-bottom:20px;">
    <div class="table-card-head"><h3>عن المقرر</h3></div>
    <div class="side-card-body" style="padding:18px 22px;line-height:1.9;color:var(--text-secondary);"><%= course.description %></div>
  </div>
<% } %>

<div class="grid-2" style="margin-bottom:20px;">
  <div class="table-card">
    <div class="table-card-head">
      <h3>المحاضرات (<%= lectureCount %>)</h3>
      <a class="card-link" href="<%= basePath %>/lectures/new?course=<%= course.id %>">إضافة</a>
    </div>
    <div class="table-scroll">
      <table class="data-table">
        <thead><tr><th>المحاضرة</th><th>الموعد</th><th>الحضور</th></tr></thead>
        <tbody>
          <% if (lectures.length) { %>
            <% for (const lecture of lectures) { %>
              <tr>
                <td><strong><a href="<%= basePath %>/lectures/<%= lecture.id %>" style="color:inherit;text-decoration:none;"><%= lecture.title %></a></strong></td>
                <td><%= format.formatDateTime(lecture.scheduled_at) %></td>
                <td><%= lecture.attendance_open ? 'مفتوح' : '—' %></td>
              </tr>
            <% } %>
          <% } else { %>
            <tr><td colspan="3" class="muted text-center">لا توجد محاضرات بعد.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="table-card">
    <div class="table-card-head">
      <h3>الاختبارات (<%= exams.length %>)</h3>
      <a class="card-link" href="<%= basePath %>/exams/new?course=<%= course.id %>">إضافة</a>
    </div>
    <div class="table-scroll">
      <table class="data-table">
        <thead><tr><th>الاختبار</th><th>يبدأ</th><th>الحالة</th></tr></thead>
        <tbody>
          <% if (exams.length) { %>
            <% for (const exam of exams) { %>
              <tr>
                <td><strong><a href="<%= basePath %>/exams/<%= exam.id %>" style="color:inherit;text-decoration:none;"><%= exam.title %></a></strong></td>
                <td><%= exam.starts_at ? format.formatDateTime(exam.starts_at) : '—' %></td>
                <td><span class="chip"><%= exam.is_published ? 'منشور' : 'مسودة' %></span></td>
              </tr>
            <% } %>
          <% } else { %>
            <tr><td colspan="3" class="muted text-center">لا توجد اختبارات بعد.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if (getProfile(course.track).tool === 'assignment') { %>
<div class="table-card" style="margin-bottom:20px;">
  <div class="table-card-head">
    <h3>الواجبات (<%= assignments.length %>)</h3>
    <% if (isOwner) { %><a class="card-link" href="<%= basePath %>/assignments/new?course=<%= course.id %>">إضافة</a><% } %>
  </div>
  <div class="table-scroll">
    <table class="data-table">
      <thead><tr><th>الواجب</th><th>الموعد</th><th>الدرجة القصوى</th></tr></thead>
      <tbody>
        <% if (assignments.length) { %>
          <% for (const assignment of assignments) { %>
            <tr>
              <td><strong><% if (isOwner) { %><a href="<%= basePath %>/assignments/<%= assignment.id %>" style="color:inherit;text-decoration:none;"><%= assignment.title %></a><% } else { %><%= assignment.title %><% } %></strong></td>
              <td><%= assignment.due_at ? format.formatDateTime(assignment.due_at) : 'بدون موعد' %></td>
              <td><%= assignment.max_points %></td>
            </tr>
          <% } %>
        <% } else { %>
          <tr><td colspan="3" class="muted text-center">لا توجد واجبات بعد.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<div class="table-card">
  <div class="table-card-head">
    <h3>طلاب المقرر (<%= students.length %>)</h3>
    <% if (isOwner) { %><a class="card-link" href="<%= basePath %>/courses/<%= course.id %>/enroll">تسجيل الطلاب</a><% } %>
  </div>
  <div class="table-scroll">
    <table class="data-table">
      <thead><tr><th>#</th><th>الاسم</th><th>الرمز</th><th>الحضور</th><th>حالة الحساب</th><th>التسجيل في المقرر</th><th>إجراء</th></tr></thead>
      <tbody>
        <% if (students.length) { %>
          <% for (const student of students) { %>
            <% var suspended = student.enrollmentStatus === 'suspended'; %>
            <tr>
              <td><%= student.id %></td>
              <td><strong><a href="<%= basePath %>/students/<%= student.id %>" title="عرض بيانات الطالب"><%= student.name %></a></strong></td>
              <td dir="ltr" style="text-align:left;"><code><%= student.platform_id ?? student.university_id ?? '—' %></code></td>
              <td><%= student.attendanceCount %> محاضرة</td>
              <td><span class="chip" style="<%= student.is_active ? 'color:var(--success);border-color:var(--success-border);' : 'color:var(--danger);border-color:var(--danger-border);' %>"><%= student.is_active ? 'نشط' : 'موقوف' %></span></td>
              <td>
                <span class="chip" style="<%= suspended ? 'color:var(--danger);border-color:var(--danger-border);' : 'color:var(--success);border-color:var(--success-border);' %>"><%= suspended ? 'موقوف في هذا المقرر' : 'نشط في هذا المقرر' %></span>
              </td>
              <td>
                <a class="btn btn-secondary btn-sm" href="<%= basePath %>/students/<%= student.id %>">بيانات الطالب</a>
                <form method="post" action="<%= basePath %>/courses/<%= course.id %>/enroll/<%= student.id %>/status" style="display:inline;">
                  <input type="hidden" name="status" value="<%= suspended ? 'active' : 'suspended' %>">
                  <button type="submit" class="btn btn-secondary btn-sm"><%= suspended ? 'إعادة تنشيط' : 'توقيف في المقرر' %></button>
                </form>
              </td>
            </tr>
          <% } %>
        <% } else { %>
          <tr><td colspan="7" class="muted text-center">لا يوجد طلاب مسجلون في هذا المقرر بعد.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
