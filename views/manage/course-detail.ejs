<section class="page-header">
  <div class="page-header-info">
    <h2><%= course.title %></h2>
    <p><code><%= course.code %></code> · <%= course.track === 'equiv' ? 'قسم المعادلة' : 'مسار البكالوريوس' %> · <%= course.level ? 'المستوى ' + course.level : '' %></p>
  </div>
  <div class="page-header-actions">
    <a class="btn btn-secondary" href="<%= basePath %>/courses/<%= course.id %>/gradebook">سجل الدرجات</a>
    <a class="btn btn-secondary" href="<%= basePath %>/courses/<%= course.id %>/edit">تعديل</a>
    <form method="post" action="<%= basePath %>/courses/<%= course.id %>/archive" style="display:inline;">
      <button type="submit" class="btn btn-secondary"><%= course.archived ? 'إعادة تفعيل' : 'أرشفة المقرر' %></button>
    </form>
  </div>
</section>

<% if (course.description) { %>
  <div class="table-card" style="margin-bottom:20px;">
    <div class="table-card-head"><h3>عن المقرر</h3></div>
    <div class="side-card-body" style="padding:18px 22px;line-height:1.9;color:var(--text-secondary);"><%= course.description %></div>
  </div>
<% } %>

<div class="grid-2" style="margin-bottom:20px;">
  <div class="table-card">
    <div class="table-card-head">
      <h3>المحاضرات (<%= lectureCount %>)</h3>
      <a class="card-link" href="<%= basePath %>/lectures/new?course=<%= course.id %>">إضافة</a>
    </div>
    <div class="table-scroll">
      <table class="data-table">
        <thead><tr><th>المحاضرة</th><th>الموعد</th><th>الحضور</th></tr></thead>
        <tbody>
          <% if (lectures.length) { %>
            <% for (const lecture of lectures) { %>
              <tr>
                <td><strong><a href="<%= basePath %>/lectures/<%= lecture.id %>" style="color:inherit;text-decoration:none;"><%= lecture.title %></a></strong></td>
                <td><%= format.formatDateTime(lecture.scheduled_at) %></td>
                <td><%= lecture.attendance_open ? 'مفتوح' : '—' %></td>
              </tr>
            <% } %>
          <% } else { %>
            <tr><td colspan="3" class="muted text-center">لا توجد محاضرات بعد.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="table-card">
    <div class="table-card-head">
      <h3>الاختبارات (<%= exams.length %>)</h3>
      <a class="card-link" href="<%= basePath %>/exams/new?course=<%= course.id %>">إضافة</a>
    </div>
    <div class="table-scroll">
      <table class="data-table">
        <thead><tr><th>الاختبار</th><th>يبدأ</th><th>الحالة</th></tr></thead>
        <tbody>
          <% if (exams.length) { %>
            <% for (const exam of exams) { %>
              <tr>
                <td><strong><a href="<%= basePath %>/exams/<%= exam.id %>" style="color:inherit;text-decoration:none;"><%= exam.title %></a></strong></td>
                <td><%= exam.starts_at ? format.formatDateTime(exam.starts_at) : '—' %></td>
                <td><span class="chip"><%= exam.is_published ? 'منشور' : 'مسودة' %></span></td>
              </tr>
            <% } %>
          <% } else { %>
            <tr><td colspan="3" class="muted text-center">لا توجد اختبارات بعد.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="table-card" style="margin-bottom:20px;">
  <div class="table-card-head">
    <h3>الواجبات (<%= assignments.length %>)</h3>
    <a class="card-link" href="<%= basePath %>/assignments/new?course=<%= course.id %>">إضافة</a>
  </div>
  <div class="table-scroll">
    <table class="data-table">
      <thead><tr><th>الواجب</th><th>الموعد</th><th>الدرجة القصوى</th></tr></thead>
      <tbody>
        <% if (assignments.length) { %>
          <% for (const assignment of assignments) { %>
            <tr>
              <td><strong><a href="<%= basePath %>/assignments/<%= assignment.id %>" style="color:inherit;text-decoration:none;"><%= assignment.title %></a></strong></td>
              <td><%= assignment.due_at ? format.formatDateTime(assignment.due_at) : 'بدون موعد' %></td>
              <td><%= assignment.max_points %></td>
            </tr>
          <% } %>
        <% } else { %>
          <tr><td colspan="3" class="muted text-center">لا توجد واجبات بعد.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<div class="table-card">
  <div class="table-card-head"><h3>طلاب المقرر (<%= students.length %>)</h3></div>
  <div class="table-scroll">
    <table class="data-table">
      <thead><tr><th>#</th><th>الاسم</th><th>الرقم الجامعي</th><th>الحضور</th><th>الحالة</th></tr></thead>
      <tbody>
        <% if (students.length) { %>
          <% for (const student of students) { %>
            <tr>
              <td><%= student.id %></td>
              <td><strong><%= student.name %></strong></td>
              <td dir="ltr" style="text-align:left;"><code><%= student.university_id ?? '—' %></code></td>
              <td><%= student.attendanceCount %> محاضرة</td>
              <td><span class="chip" style="<%= student.is_active ? 'color:var(--success);border-color:var(--success-border);' : 'color:var(--danger);border-color:var(--danger-border);' %>"><%= student.is_active ? 'نشط' : 'موقوف' %></span></td>
            </tr>
          <% } %>
        <% } else { %>
          <tr><td colspan="5" class="muted text-center">لا يوجد طلاب مسجلون في هذا المقرر بعد.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
