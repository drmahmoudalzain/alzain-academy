<section class="page-header">
  <div class="page-header-info">
    <h2>تسجيل الطلاب في المقرر</h2>
    <p><code><%= course.code %></code> · <%= course.title %> — يُسجَّل في هذا المقرر طلاب مستواه فقط<% if (fixedLevel) { %> (المستوى <%= fixedLevel %>)<% } %>، ومع الأصل يُضاف الفرع الموافق لجنس الطالب لا الفرع الآخر.</p>
  </div>
  <div class="page-header-actions">
    <a class="btn btn-secondary" href="<%= basePath %>/courses/<%= course.id %>">العودة إلى المقرر</a>
  </div>
</section>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert-inline error" role="alert" style="margin-bottom:16px;">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
    <div><%= error %></div>
  </div>
<% } %>

<div class="table-card" style="margin-bottom:18px;">
  <div class="table-card-head" style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;">
    <h3>الطلاب (<%= students.length %>)</h3>
    <a class="card-link" href="?q=">إعادة الضبط إلى مستوى المقرر ومساره</a>
  </div>
  <div class="side-card-body" style="padding:14px 20px;">
    <form method="get" action="<%= basePath %>/courses/<%= course.id %>/enroll" class="filter-form" style="display:flex;gap:10px;flex-wrap:wrap;align-items:end;">
      <label style="flex:2;min-width:180px;">بحث بالاسم أو الرمز
        <input type="text" name="q" value="<%= q %>" placeholder="اسم أو BM0001..." dir="auto">
      </label>
      <label style="flex:1;min-width:140px;">المسار
        <select name="track">
          <% if (studentTracks.length > 1) { %>
            <option value="all" <%= trackFilter === 'all' ? 'selected' : '' %>>الطلاب والطالبات معاً</option>
          <% } %>
          <% studentTracks.forEach(function (key) { %>
            <option value="<%= key %>" <%= trackFilter === key ? 'selected' : '' %>><%= getProfile(key).label %></option>
          <% }); %>
        </select>
      </label>
      <label style="flex:1;min-width:110px;">المستوى (من المقرر)
        <input type="text" value="<%= fixedLevel ? 'المستوى ' + fixedLevel : 'كل المستويات' %>" disabled>
      </label>
      <button class="btn btn-secondary" type="submit">تصفية</button>
    </form>
  </div>
</div>

<div class="table-card" style="margin-bottom:18px;">
  <div class="table-card-head"><h3>تسجيل دفعة واحدة / إضافة طالب عند الضرورة</h3></div>
  <div class="side-card-body" style="padding:16px 20px;display:flex;gap:14px;flex-wrap:wrap;align-items:end;">
    <form method="post" action="<%= basePath %>/courses/<%= course.id %>/enroll" onsubmit="return confirm('تسجيل طلاب مستوى هذا المقرر المطابقين للتصفية في المقررات المختارة؟');">
      <input type="hidden" name="bulk_all" value="1">
      <input type="hidden" name="course_ids" value="<%= course.id %>">
      <input type="hidden" name="track_filter" value="<%= trackFilter %>">
      <input type="hidden" name="level_filter" value="<%= levelFilter %>">
      <input type="hidden" name="q_filter" value="<%= q %>">
      <button type="submit" class="btn btn-primary">تسجيل كل طلاب المستوى دفعة واحدة</button>
    </form>
    <form method="post" action="<%= basePath %>/courses/<%= course.id %>/enroll/by-code" style="display:flex;gap:8px;align-items:end;">
      <label>رمز الطالب أو الرقم الأكاديمي
        <input type="text" name="student_code" required maxlength="24" dir="ltr" style="text-align:left;" placeholder="BM0001">
      </label>
      <button type="submit" class="btn btn-secondary">إضافة طالب بعينه</button>
    </form>
    <p class="form-hint mb-0" style="flex:1;min-width:220px;">زر الدفعة يسجّل طلاب مستوى المقرر فقط (ومع الأصل فرع كل طالب بحسب جنسه)، ويتخطّى المسجّلين سابقاً. زر الطالب بعينه هو الاستثناء لإضافة أي طالب إلى أي مقرر عند الضرورة.</p>
  </div>
</div>

<% if (isOwner) { %>
  <details class="table-card" style="margin-bottom:18px;">
    <summary class="table-card-head" style="cursor:pointer;list-style:none;">
      <h3>طالب فاته الكشف؟ أنشئ حسابه وسجّله هنا مباشرة</h3>
      <span class="card-link" style="border:none;background:none;">فتح النموذج</span>
    </summary>
    <form method="post" action="<%= basePath %>/courses/<%= course.id %>/enroll/quick-create" class="side-card-body" style="padding:16px 20px;border-top:1px solid var(--border);">
      <p class="form-hint" style="margin-top:0;">يُنشأ الحساب برمز تالٍ حسب المسار وكلمة مرور مؤقتة تظهر مرة واحدة، ويُسجَّل فوراً في <strong><%= course.title %></strong> ويصله إشعار داخلي.</p>
      <div class="form-grid">
        <label>الاسم الرباعي *
          <input type="text" name="name" required maxlength="120" placeholder="مثال: أحمد سالم باوزير">
        </label>
        <label>المسار *
          <select name="track" required>
            <% studentTracks.forEach(function (key) { %>
              <option value="<%= key %>" <%= key === course.track ? 'selected' : '' %>><%= getProfile(key).label %> — <%= key %></option>
            <% }); %>
          </select>
        </label>
        <label>المستوى (من المقرر)
          <input type="text" value="<%= fixedLevel ? 'المستوى ' + fixedLevel : 'كل المستويات' %>" disabled>
          <% if (fixedLevel) { %><input type="hidden" name="level" value="<%= fixedLevel %>"><% } %>
        </label>
        <label>الرقم الأكاديمي <span class="muted">(اختياري)</span>
          <input type="text" name="university_id" maxlength="20" dir="ltr" style="text-align:left;" placeholder="2024009">
        </label>
        <label>البريد الإلكتروني <span class="muted">(اختياري)</span>
          <input type="email" name="email" maxlength="160" dir="ltr" style="text-align:left;" placeholder="student@example.com">
        </label>
      </div>
      <div style="margin-top:14px;">
        <button type="submit" class="btn btn-primary">إنشاء الطالب وتسجيله في المقرر</button>
      </div>
    </form>
  </details>
<% } %>

<form method="post" action="<%= basePath %>/courses/<%= course.id %>/enroll" id="enrollForm">
  <div class="table-card" style="margin-bottom:18px;">
    <div class="table-card-head"><h3>المقررات المحددة للتسجيل</h3></div>
    <div class="side-card-body" style="padding:16px 20px;">
      <p class="form-hint" style="margin-top:0;">تظهر هنا مقررات المستوى نفسه والمسار المتوافق فقط، حتى لا يُسجَّل طالب من مستوى آخر. اختر مقرراً واحداً أو أكثر.</p>
      <div class="course-pick-grid">
        <% courses.forEach(function (item) { %>
          <label class="course-pick">
            <input type="checkbox" name="course_ids" value="<%= item.id %>" <%= Number(item.id) === Number(course.id) ? 'checked' : '' %>>
            <span><strong><%= item.title %></strong><small dir="ltr"><%= item.code %> · <%= getProfile(item.track).label %><%= item.level ? ' · م' + item.level : '' %></small></span>
          </label>
        <% }); %>
      </div>
    </div>
  </div>

  <div class="table-card" style="margin-bottom:18px;">
    <div class="table-card-head"><h3>اختيار الطلاب</h3></div>
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th style="width:36px;"><input type="checkbox" id="checkAll" aria-label="تحديد الكل"></th>
            <th>الاسم</th>
            <th>الرمز</th>
            <th>المسار / المستوى</th>
            <th>الحالة في هذا المقرر</th>
            <th>إجراء</th>
          </tr>
        </thead>
        <tbody>
          <% if (students.length) { %>
            <% students.forEach(function (student) { %>
              <% var already = enrolledIds.has(student.id); %>
              <tr>
                <td>
                  <input type="checkbox" name="student_ids" value="<%= student.id %>" class="student-check" <%= already ? 'disabled title="مسجل بالفعل"' : '' %>>
                </td>
                <td><strong><a href="<%= basePath %>/students/<%= student.id %>" title="عرض بيانات الطالب"><%= student.name %></a></strong></td>
                <td dir="ltr" style="text-align:left;"><code><%= student.platform_id || student.university_id || '—' %></code></td>
                <td><%= getProfile(student.track).label %><%= student.level ? ' · م' + student.level : '' %></td>
                <td>
                  <% if (already) { %>
                    <span class="chip" style="color:var(--success);border-color:var(--success-border);">مسجل بالفعل</span>
                  <% } else { %>
                    <span class="muted">غير مسجل</span>
                  <% } %>
                </td>
                <td><a class="btn btn-secondary btn-sm" href="<%= basePath %>/students/<%= student.id %>">بيانات الطالب</a></td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="6" class="muted text-center">لا يوجد طلاب مطابقون للفلاتر الحالية.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
    <button class="btn btn-primary" type="submit">تسجيل المحدد في المقررات المختارة</button>
    <span class="form-hint mb-0">المكرر يُتخطى تلقائياً، ويصل الطالب إشعاراً داخلياً فور التسجيل.</span>
  </div>
</form>

<style>
.course-pick-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(230px,1fr)); gap:10px; max-height:220px; overflow:auto; }
.course-pick { display:flex; gap:10px; align-items:flex-start; padding:10px 12px; border:1px solid var(--border); border-radius:10px; background:var(--bg-subtle); cursor:pointer; }
.course-pick span { display:flex; flex-direction:column; gap:2px; }
.course-pick small { color:var(--text-muted); font-size:0.72rem; }
</style>

<script>
  (function () {
    var all = document.getElementById("checkAll");
    if (!all) return;
    all.addEventListener("change", function () {
      document.querySelectorAll(".student-check:not(:disabled)").forEach(function (box) { box.checked = all.checked; });
    });
  })();
</script>
