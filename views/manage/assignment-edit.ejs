<section class="page-header">
  <div class="page-header-info">
    <h2>تعديل الواجب</h2>
    <p><%= assignment.title %></p>
  </div>
</section>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert-inline error" role="alert">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
    <div><%= error %></div>
  </div>
<% } %>

<form method="post" action="<%= basePath %>/assignments/<%= assignment.id %>/edit" class="table-card">
  <div class="side-card-body" style="padding:24px;">
    <div class="form-grid">
      <label>المقرر *
        <select name="course_id" required>
          <% for (const course of courses) { %>
            <option value="<%= course.id %>" <%= Number(selectedCourse) === course.id ? 'selected' : '' %>><%= course.code %> — <%= course.title %></option>
          <% } %>
        </select>
      </label>
      <label>عنوان الواجب *
        <input type="text" name="title" value="<%= assignment.title %>" required maxlength="180">
      </label>
      <label>التعليمات
        <textarea name="description" rows="5" maxlength="4000"><%= assignment.description || '' %></textarea>
      </label>
      <div class="form-grid" style="grid-template-columns: 1.4fr 1fr;">
        <label>آخر موعد للتسليم
          <input type="datetime-local" name="due_at" value="<%= assignment.due_at ? new Date(assignment.due_at).toISOString().slice(0, 16) : '' %>">
        </label>
        <label>الدرجة القصوى
          <input type="number" name="max_points" value="<%= assignment.max_points %>" min="1" max="1000" step="0.5">
        </label>
      </div>
    </div>

    <div style="display:flex;gap:10px;margin-top:16px;">
      <button type="submit" class="btn btn-primary">حفظ التعديلات</button>
      <a class="btn btn-secondary" href="<%= basePath %>/assignments/<%= assignment.id %>">إلغاء</a>
    </div>
  </div>
</form>
