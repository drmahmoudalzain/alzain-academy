<section class="page-header">
  <div class="page-header-info">
    <h2>إضافة واجب</h2>
    <p>بيانات الواجب — وحدد آخر موعد للتسليم والدرجة القصوى.</p>
  </div>
</section>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert-inline error" role="alert">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
    <div><%= error %></div>
  </div>
<% } %>

<% if (typeof ai !== 'undefined' && ai) { %>
  <div class="table-card" style="margin-bottom:20px;">
    <div class="table-card-head"><h3>المساعد الذكي — توليد الواجب</h3></div>
    <div class="side-card-body" style="padding:16px 18px;">
      <div class="form-grid" style="grid-template-columns: 1.6fr auto; align-items:end;">
        <label>موضوع الواجب
          <input id="aiTopic" type="text" maxlength="200" placeholder="مثال: التنظيم الدستوري للسلطات">
        </label>
        <button type="button" class="btn btn-secondary" id="aiGenerateBtn" <%= ai.ready ? '' : 'disabled' %>>ولّد بالذكاء الاصطناعي</button>
      </div>
      <p id="aiNote" class="form-hint" style="margin-top:10px;">
        <% if (ai.ready) { %>بعد التوليد ستملأ حقول العنوان والوصف والدرجة القصوى — راجعها ثم احفظ.<% } else { %>المساعد الذكي غير مُفعّل — يمكن للمالك تفعيله من الإعدادات بإدخال مفتاح Gemini.<% } %>
      </p>
    </div>
  </div>
<% } %>

<form method="post" action="<%= basePath %>/assignments" class="table-card">
  <div class="side-card-body" style="padding:24px;">
    <div class="form-grid">
      <label>المقرر *
        <select name="course_id" required>
          <% for (const course of courses) { %>
            <option value="<%= course.id %>" <%= selectedCourse === course.id ? 'selected' : '' %>><%= course.code %> — <%= course.title %></option>
          <% } %>
        </select>
      </label>
      <label>عنوان الواجب *
        <input type="text" id="assignmentTitle" name="title" required maxlength="180" placeholder="مثال: بحث — مصادر القانون">
      </label>
      <label>التعليمات
        <textarea id="assignmentDescription" name="description" rows="5" maxlength="4000" placeholder="المطلوب من الطلاب بالتفصيل..."></textarea>
      </label>
      <div class="form-grid" style="grid-template-columns: 1.4fr 1fr;">
        <label>آخر موعد للتسليم
          <input type="datetime-local" name="due_at">
        </label>
        <label>الدرجة القصوى
          <input type="number" id="assignmentMaxPoints" name="max_points" value="10" min="1" max="1000" step="0.5">
        </label>
      </div>
    </div>

    <div style="display:flex;gap:10px;margin-top:18px;">
      <button type="submit" class="btn btn-primary">حفظ الواجب</button>
      <a class="btn btn-secondary" href="<%= basePath %>/assignments">إلغاء</a>
    </div>
  </div>
</form>

<script>
(function () {
  "use strict";
  const btn = document.getElementById("aiGenerateBtn");
  const topic = document.getElementById("aiTopic");
  const note = document.getElementById("aiNote");
  const courseSelect = document.querySelector("select[name='course_id']");
  const title = document.getElementById("assignmentTitle");
  const description = document.getElementById("assignmentDescription");
  const maxPoints = document.getElementById("assignmentMaxPoints");

  if (!btn || btn.disabled) return;

  btn.addEventListener("click", async () => {
    const subject = (topic && topic.value.trim())
      || (courseSelect ? courseSelect.selectedOptions[0]?.textContent?.split("—")[0].trim() : "")
      || "القانون";
    btn.disabled = true;
    if (note) note.textContent = "جارٍ توليد الواجب...";
    try {
      const body = new URLSearchParams({
        course_id: courseSelect ? courseSelect.value : "",
        topic: subject,
      }).toString();
      const res = await fetch("<%= basePath %>/ai/generate-assignment", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded", "Accept": "application/json" },
        body,
      });
      const data = await res.json();
      if (!data.ok) {
        if (note) note.textContent = data.error || "تعذر التوليد — حاول مرة أخرى.";
        return;
      }
      if (title) title.value = data.title || "";
      if (description) description.value = data.description || "";
      if (maxPoints) maxPoints.value = data.max_points || 10;
      if (note) note.textContent = "تم التوليد — راجع الحقول ثم احفظ الواجب.";
    } catch {
      if (note) note.textContent = "تعذر الاتصال بالمساعد الذكي — تحقق من الشبكة.";
    } finally {
      btn.disabled = false;
    }
  });
})();
</script>
