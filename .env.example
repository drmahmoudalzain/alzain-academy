# انسخ هذا الملف إلى .env واملأ القيم من لوحة Supabase.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_ACCESS_TOKEN=sbp_...

# المفتاح العام — تستخدمه الواجهة الجديدة واختبار الدخول
SUPABASE_ANON_KEY=

# منفذ التطوير المحلي
PORT=3001

# مدة الجلسة بالأيام
SESSION_DAYS=7

# أزرار الدخول المحلية للتطوير فقط — تُملأ في web/.env.development.local
VITE_DEV_STUDENT_ID=
VITE_DEV_STUDENT_PASSWORD=
VITE_DEV_TEACHER_ID=
VITE_DEV_TEACHER_PASSWORD=
VITE_DEV_ASSISTANT_ID=
VITE_DEV_ASSISTANT_PASSWORD=
